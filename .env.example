# Copie para .env e preencha. O .env não vai para o git.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=organizae
DB_USER=organizae
DB_PASSWORD=troque-esta-senha

# Configure uma chave aleatória de pelo menos 32 bytes para habilitar JWT.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000

# Ferramentas de leitura apenas em desenvolvimento/testes locais.
APP_ENV=production
ASSISTANT_DEMO_ENABLED=false
# Defina um UUID de uma empresa fictícia somente ao habilitar a demonstração.
# ASSISTANT_DEMO_BUSINESS_ID=
