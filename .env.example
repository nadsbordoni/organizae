# Copie para .env e preencha. O .env não vai para o git.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=organizae
DB_USER=organizae
DB_PASSWORD=troque-esta-senha

# Configure uma chave aleatória de pelo menos 32 bytes para habilitar JWT.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
ASSISTANT_CONTEXT_TOKEN_LIMIT=8192
ASSISTANT_HISTORY_TOKEN_BUDGET=4096
GEMINI_MAX_OUTPUT_TOKENS=2048

# Leituras da assistente exigem JWT e empresa vinculada ao usuário.
# Escritas com confirmação são opcionais e restritas a development.
APP_ENV=development
ASSISTANT_WRITES_ENABLED=true

# Fuso dos horários de atendimento e do agendamento online.
BUSINESS_TIMEZONE=America/Sao_Paulo

# Assinatura: dias de teste gratis e dias de carencia depois do atraso.
TRIAL_DAYS=15
GRACE_DAYS=5

# Cobranca via Asaas. Sem ASAAS_API_KEY o checkout responde 503. Comece pelo sandbox
# (a URL abaixo) e troque por https://api.asaas.com/v3 so em producao.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Token que o Asaas envia no header asaas-access-token em cada webhook. Gere um
# valor aleatorio longo e cadastre o mesmo no painel do Asaas.
ASAAS_WEBHOOK_TOKEN=
