# Copie para .env e preencha. O .env não vai para o git.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=organizae
DB_USER=organizae
DB_PASSWORD=troque-esta-senha

# Configure uma chave aleatória de pelo menos 32 bytes para habilitar JWT.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
ASSISTANT_CONTEXT_TOKEN_LIMIT=8192

# Leituras da assistente exigem JWT e empresa vinculada ao usuário.
# Escritas com confirmação são opcionais e restritas a development.
APP_ENV=development
ASSISTANT_WRITES_ENABLED=true
