# Copie para .env e preencha. O .env não vai para o git.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=organizae
DB_USER=organizae
DB_PASSWORD=troque-esta-senha

# Configure uma chave aleatória de pelo menos 32 bytes para habilitar JWT.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
ASSISTANT_CONTEXT_TOKEN_LIMIT=8192
ASSISTANT_HISTORY_TOKEN_BUDGET=4096
GEMINI_MAX_OUTPUT_TOKENS=2048

# Leituras da assistente exigem JWT e empresa vinculada ao usuário.
# Escritas com confirmação são opcionais e restritas a development.
APP_ENV=development
ASSISTANT_WRITES_ENABLED=true

# Seed do "docker compose up" (exige APP_ENV development/test). Por padrão cria a
# empresa fictícia 00000000-0000-4000-8000-000000000001 e a popula. Com
# SEED_USER_EMAIL e SEED_USER_PASSWORD (8+ caracteres), cria também o login do dono.
# SEED_BUSINESS_ID popula outra empresa já existente no lugar da fictícia.
# Login apenas para testes locais: troque a senha e não reutilize uma senha real.
SEED_USER_EMAIL=dono.testes@example.com
SEED_USER_PASSWORD=teste123
SEED_BUSINESS_ID=

# Fuso dos horários de atendimento e do agendamento online.
BUSINESS_TIMEZONE=America/Sao_Paulo

# E-mails de confirmação e lembrete. Sem SMTP_HOST nada é enviado (só vai para o log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
