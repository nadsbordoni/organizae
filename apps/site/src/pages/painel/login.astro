---
import AuthLayout from '@/layouts/AuthLayout.astro';
import ActionButton from '@/components/ActionButton.astro';
import Heading from '@/components/Heading.astro';
import TextField from '@/components/TextField.astro';

/**
 * Entrada do painel, sem slug de propósito: o negócio vem da sessão. Aqui vale o tema do Organizaê.
 * "Esqueci minha senha" e "Começar agora" do protótipo só entram quando essas telas existirem.
 */
export const prerender = false;

const erro = Astro.url.searchParams.get('erro');
// Repassado SEM validar: quem valida é `safeNext()` em `/api/login`.
const next = Astro.url.searchParams.get('next') ?? '';

const MENSAGENS: Record<string, string> = {
  credenciais: 'E-mail ou senha incorretos.',
  erro: 'Não foi possível entrar agora. Tente de novo em instantes.',
};
const aviso = erro ? (MENSAGENS[erro] ?? MENSAGENS.erro!) : null;
---

<AuthLayout title="Entrar">
  <Heading
    eyebrow="Bem-vindo de volta"
    title="Seu negócio, no lugar."
    intro="Acesse sua conta e continue organizando tudo com leveza."
  />

  {
    aviso && (
      /* `role="alert"` faz o leitor de tela anunciar sem precisar de foco. */
      <p class="login__erro" role="alert">{aviso}</p>
    )
  }

  {/* PROTÓTIPO: sem autenticação. Troque pelo POST de login da API. */}
  <form class="login__form" method="post" action="/painel" data-prototype>
    {next && <input type="hidden" name="next" value={next} />}
    <TextField
      id="email"
      label="E-mail"
      type="email"
      autocomplete="email"
      placeholder="voce@empresa.com.br"
      required
      autofocus
    />
    <TextField
      id="password"
      label="Senha"
      type="password"
      autocomplete="current-password"
      placeholder="Sua senha"
      required
    />

    <div class="login__row">
      <label class="login__lembrar">
        <input type="checkbox" name="lembrar" checked />
        Manter conectado
      </label>
      <a class="login__link" href="/painel/senha">Esqueci minha senha</a>
    </div>

    <ActionButton label="Entrar" type="submit" variant="primary" />

    <p class="login__signup">
      Ainda não tem uma conta? <a class="login__link" href="/painel/cadastro">Começar agora</a>
    </p>
  </form>
</AuthLayout>

<style>
  .login__erro {
    margin-top: 24px;
    padding: 12px 14px;
    border-radius: var(--site-radius-field);
    border: 1px solid #d98b8b;
    background: #fdecec;

    font-size: 0.875rem;
    line-height: 1.45;
    /* Contraste conferido sobre o fundo claro: acima de 7:1. */
    color: #7a1f2b;
  }

  .login__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 32px;
  }

  .login__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .login__link {
    font-weight: 600;
    color: var(--site-color-text);
    text-decoration: none;
  }

  .login__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .login__link:focus-visible {
    outline: 3px solid var(--site-color-brand-deep);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .login__row .login__link,
  .login__signup {
    font-size: 0.8125rem;
  }

  .login__signup {
    color: var(--site-color-text-muted);
  }

  .login__lembrar {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--site-color-text-muted);
    cursor: pointer;
  }

  .login__lembrar input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--site-color-brand);
  }
</style>
