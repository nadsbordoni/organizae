---
import PanelLayout from '@/layouts/PanelLayout.astro';
import ActionButton from '@/components/ActionButton.astro';
import Callout from '@/components/Callout.astro';
import Icon from '@/components/Icon.astro';
import ActionsMenu from '@/components/painel/ActionsMenu.astro';
import PanelHeading from '@/components/painel/PanelHeading.astro';
import { getSite } from '@/config';
import { formatDuration } from '@/lib/agenda';
import { SERVICE_STATE, serviceState } from '@/lib/catalog';
import { compactPrice, tenantNotConfigured } from '@/lib/painel';

/**
 * Catálogo de serviços (quadro 04), agrupado por categoria como aparece no agendamento: o
 * protótipo mostra uma grade única, mas com muitos serviços a categoria organiza. Sem o bloco
 * colorido do protótipo, que ocupava o lugar de uma foto que a cliente nunca vê.
 */
export const prerender = false;

const user = Astro.locals.user;
const site = getSite(user.tenantSlug);
if (!site) return tenantNotConfigured(user.tenantSlug);

const categories = site.agenda?.categories ?? [];

// PROTÓTIPO: os formulários voltam para cá com `?novo` ou `?salvo`, sem gravar nada.
const created = Astro.url.searchParams.has('novo');
const saved = Astro.url.searchParams.has('salvo');
---

<PanelLayout site={site} user={user} current="servicos" title="Serviços">
  <PanelHeading eyebrow="Catálogo" title="Serviços" intro="Organize seu portfólio, preços e duração dos atendimentos.">
    <ActionButton label="Novo serviço" icon="plus" iconPosition="end" href="/painel/servicos/novo" full={false} />
  </PanelHeading>

  {
    (created || saved) && (
      <div class="notice">
        <Callout tone="success" icon="check-circle" title={created ? 'Serviço cadastrado' : 'Serviço salvo'}>
          {created ? 'O serviço já aparece no catálogo.' : 'As alterações já valem para os próximos agendamentos.'}
        </Callout>
      </div>
    )
  }

  {
    categories.map((category) => (
      <section class="group" aria-labelledby={`categoria-${category.id}`}>
        <header class="group__head">
          <h2 id={`categoria-${category.id}`}>{category.name}</h2>
          <p>
            {category.services.length} {category.services.length === 1 ? 'serviço' : 'serviços'}
            {category.description && ` · ${category.description}`}
          </p>
        </header>

        <ul class="cards">
          {category.services.map((service) => {
            const state = serviceState(service);
            const edit = `/painel/servicos/${service.id}/editar`;
            return (
              <li class="card">
                <div class="card__title">
                  <h3>
                    <a href={edit}>{service.name}</a>
                  </h3>
                  <span class="card__state" data-state={state}>
                    {SERVICE_STATE[state].label}
                  </span>
                  <ActionsMenu id={`menu-${service.id}`} label={`Ações para ${service.name}`}>
                    <a href={edit}>Editar serviço</a>
                    <a href={`/${site.slug}/agendar`} target="_blank" rel="noopener noreferrer">
                      Ver na página de agendamento
                    </a>
                  </ActionsMenu>
                </div>
                {service.description && <p class="card__desc">{service.description}</p>}
                <p class="card__meta">
                  <span class="card__time">
                    <Icon name="clock" size={16} />
                    {formatDuration(service.durationMinutes)}
                  </span>
                  <strong>{service.price ? compactPrice(service.price) : 'Sem preço'}</strong>
                </p>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</PanelLayout>

<style>
  .notice {
    margin-top: 24px;
  }

  .group {
    margin-top: 40px;
  }

  .group__head h2 {
    font-size: 1.1875rem;
    font-weight: 600;
  }

  .group__head p {
    margin-top: 4px;
    font-size: 0.875rem;
    color: var(--site-color-text-muted);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 18px;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 16px 20px 22px;
    border-radius: var(--site-radius-card);
    border: 1px solid var(--site-color-border);
    background: var(--site-color-surface);
  }

  .card__title {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .card__state {
    margin-left: auto;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--site-color-brand-soft);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .card__state[data-state='active'] {
    background: var(--site-panel-positive-soft);
    color: var(--site-accent-green-deep);
  }

  .card__state[data-state='soon'] {
    background: var(--site-panel-info-soft);
  }

  .card__title h3 {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .card__title a {
    color: var(--site-color-text);
    text-decoration: none;
  }

  .card__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card__title a:focus-visible {
    outline: 3px solid var(--site-color-brand-deep);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .card__desc {
    font-size: 0.875rem;
    color: var(--site-color-text-muted);
  }

  .card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 8px;
  }

  .card__time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    color: var(--site-color-text-muted);
  }

  .card__meta strong {
    font-size: 1.0625rem;
    font-weight: 700;
  }
</style>
