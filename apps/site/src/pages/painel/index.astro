---
import PanelLayout from '@/layouts/PanelLayout.astro';
import ActionButton from '@/components/ActionButton.astro';
import BarChart from '@/components/painel/BarChart.astro';
import PanelHeading from '@/components/painel/PanelHeading.astro';
import PanelSection from '@/components/painel/PanelSection.astro';
import PanelTable from '@/components/painel/PanelTable.astro';
import PeriodBar from '@/components/painel/PeriodBar.astro';
import StatCard from '@/components/painel/StatCard.astro';
import { getSite } from '@/config';
import { dayNumber, nowInBusinessTime } from '@/lib/agenda';
import { csvHref } from '@/lib/csv';
import { usuarioExemplo } from '@/lib/dados-exemplo';
import { DEMO_OPENING_BALANCE } from '@/lib/demo-finance';
import {
  cashOf,
  change,
  flowBy,
  money,
  moneyChange,
  monthShort,
  percent,
  pointsChange,
  rangeLabel,
  resultOf,
  slices,
} from '@/lib/finance';
import type { Range } from '@/lib/finance';
import { loadFinance } from '@/lib/finance-page';
import { numericDate, tenantNotConfigured } from '@/lib/painel';

/**
 * Visão geral (quadro 07): o mês até hoje contra o mesmo trecho do mês anterior. Resultado pela
 * competência, caixa pelo dia do pagamento, e os dois lado a lado para não serem confundidos.
 * Números de DEMONSTRAÇÃO (`lib/demo-finance.ts`), coerentes com a Agenda e os Clientes do exemplo.
 */
export const prerender = false;

const user = usuarioExemplo;
const site = getSite(user.tenantSlug);
if (!site) return tenantNotConfigured(user.tenantSlug);

const hoje = nowInBusinessTime(site.agenda?.timezone ?? 'America/Sao_Paulo').date;
const { dados, entries, groups, months, period } = await loadFinance(Astro.url, user.tenantSlug, hoje);

const now = resultOf(entries, period, groups);
const before = resultOf(entries, period.previous, groups);
const cash = cashOf(entries, period, DEMO_OPENING_BALANCE);
const mon = monthShort(period.previous.from);
const vs = (current: number, previous: number) =>
  `${mon}: ${money(previous)} · ${moneyChange(current, previous)} / ${change(current, previous) ?? '—'}`;

const clients = await dados.clients();
const clientsUntil = (date: string) => clients.filter((c) => c.created_at.slice(0, 10) <= date).length;
const clientsNow = clientsUntil(period.to);
const clientsBefore = clientsUntil(period.previous.to);
const booked = async (range: Range) =>
  (await dados.appointmentsBetween(range.from, range.to)).filter((a) => a.status !== 'cancelled').length;
const bookedNow = await booked(period);
const bookedBefore = await booked(period.previous);
const countVs = (current: number, previous: number) =>
  `${current - previous >= 0 ? '+' : '−'}${Math.abs(current - previous)} / ${change(current, previous) ?? '—'}`;

// Quatro pedaços do período, como no protótipo: "01–04 nov".
const days = dayNumber(period.to) - dayNumber(period.from) + 1;
const movement = flowBy(entries, slices(period, Math.ceil(days / 4)), 'cash').map((f) => ({
  ...f,
  label: `${f.range.from.slice(8, 10)}–${f.range.to.slice(8, 10)} ${monthShort(f.range.to).toLowerCase()}`,
}));
const short = (r: Range) => `${r.from.slice(8, 10)}–${numericDate(r.to)}`;
const marginText = (m?: number) => (m === undefined ? '—' : percent(m));

const csv = csvHref([
  ['Indicador', rangeLabel(period), rangeLabel(period.previous)],
  ['Faturamento', money(now.income), money(before.income)],
  ['Despesas + impostos', money(now.expenses), money(before.expenses)],
  ['Resultado', money(now.result), money(before.result)],
  ['Margem', marginText(now.margin), marginText(before.margin)],
  ['Entradas recebidas', money(cash.received), ''],
  ['Saídas pagas', money(cash.paid), ''],
]);
---

<PanelLayout site={site} user={user} current="home" title="Visão geral">
  <PanelHeading
    eyebrow="Visão geral"
    title="Seu negócio, com clareza"
    intro={`${site.profile.name} · Comparações sobre períodos equivalentes.`}
  >
    <ActionButton
      label="Exportar resumo"
      variant="secondary"
      icon="download"
      iconPosition="end"
      href={csv}
      download={`resumo-${period.key}.csv`}
      full={false}
    />
  </PanelHeading>

  <div class="block">
    <PeriodBar
      title={rangeLabel(period)}
      compare={`Comparado a ${rangeLabel(period.previous)}`}
      months={months}
      current={period.key}
      chips={['Todos os serviços e produtos']}
    />
  </div>

  <div class="stats">
    <StatCard label="Faturamento" value={money(now.income)} note={vs(now.income, before.income)} tone="pink" />
    <StatCard label="Despesas + impostos" value={money(now.expenses)} note={vs(now.expenses, before.expenses)} tone="yellow" />
    <StatCard label="Resultado / lucro" value={money(now.result)} note={vs(now.result, before.result)} tone="green" />
    <StatCard
      label="Margem do resultado"
      value={marginText(now.margin)}
      note={`${mon}: ${marginText(before.margin)} · ${pointsChange(now.margin, before.margin) ?? '—'}`}
      tone="blue"
    />
  </div>

  <div class="row">
    <StatCard
      label="Total de clientes cadastrados"
      value={String(clientsNow)}
      note={`Base até ${numericDate(period.to, false)} vs. ${clientsBefore} até ${numericDate(period.previous.to, false)} · ${countVs(clientsNow, clientsBefore)}`}
      tone="pink"
    />
    <StatCard
      label="Agendamentos no período"
      value={String(bookedNow)}
      note={`${bookedBefore} em ${short(period.previous)} · ${countVs(bookedNow, bookedBefore)} · Inclui confirmados e concluídos`}
      tone="yellow"
    />
    <section class="how" aria-labelledby="titulo-calculo">
      <h2 id="titulo-calculo">Como o resultado foi calculado</h2>
      <p>
        {money(now.income)} de receita − {money(now.costs)} de custos − {money(now.taxes)} de impostos = {money(now.result)}.
        Margem = resultado ÷ receita. Base: competência no período; não é saldo bancário.
      </p>
    </section>
  </div>

  <div class="grid">
    <PanelSection
      title="Movimento de caixa"
      subtitle={`Entradas e saídas efetivamente recebidas / pagas em ${short(period)}`}
      id="titulo-caixa"
    >
      <p class="legend" aria-hidden="true">
        <span class="legend__in">Entradas</span>
        <span class="legend__out">Saídas</span>
      </p>
      <BarChart groups={movement} label="Entradas e saídas por trecho do período" values />
      <dl class="totals">
        <div>
          <dt>Entradas recebidas</dt>
          <dd class="totals__in">{money(cash.received)}</dd>
        </div>
        <div>
          <dt>Saídas pagas</dt>
          <dd class="totals__out">{money(cash.paid)}</dd>
        </div>
        <div>
          <dt>Entradas − saídas</dt>
          <dd class="totals__net">{money(cash.received - cash.paid)}</dd>
        </div>
      </dl>
    </PanelSection>

    <PanelSection
      title="Saldo de caixa, não lucro"
      subtitle={`Caixa de ${site.profile.name} · posição em ${numericDate(period.to, false)}`}
      id="titulo-saldo"
    >
      <PanelTable label="Composição do saldo de caixa">
        <thead>
          <tr>
            <th scope="col">Composição</th>
            <th scope="col">Valor</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Saldo inicial em {numericDate(period.from, false)}</th>
            <td>{money(cash.opening)}</td>
          </tr>
          <tr>
            <th scope="row">+ Entradas recebidas</th>
            <td>{money(cash.received)}</td>
          </tr>
          <tr>
            <th scope="row">− Saídas pagas</th>
            <td>{money(cash.paid)}</td>
          </tr>
          <tr>
            <th scope="row">Saldo final em {numericDate(period.to, false)}</th>
            <td>{money(cash.closing)}</td>
          </tr>
        </tbody>
      </PanelTable>
      <p class="note">
        A receber do período: {money(cash.receivable)}. Obrigações do período ainda não pagas: {money(cash.payable)}. Por isso
        caixa e lucro diferem.
      </p>
    </PanelSection>
  </div>
</PanelLayout>

<style>
  .block {
    margin-top: 32px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
  }

  .how {
    padding: 24px;
    border-radius: var(--site-radius-card);
    border: 1px solid var(--site-color-border);
    background: var(--site-color-surface);
  }

  .how h2 {
    font-size: 1rem;
    font-weight: 600;
  }

  .how p {
    margin-top: 12px;
    font-size: 0.875rem;
    line-height: 1.55;
  }

  /* Proporção medida no protótipo. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    align-items: start;
    gap: 16px;
    margin-top: 16px;
  }

  .legend {
    display: flex;
    gap: 12px;
  }

  .legend span {
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .legend__in {
    background: var(--site-accent-pink-soft);
  }

  .legend__out {
    background: var(--site-accent-blue-soft);
  }

  .totals {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
  }

  .totals dt {
    font-size: 0.8125rem;
    color: var(--site-color-text-muted);
  }

  .totals dd {
    margin: 4px 0 0;
    font-family: var(--site-font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .totals__in {
    color: var(--site-accent-pink-deep);
  }

  .totals__out {
    color: var(--site-accent-blue-deep);
  }

  .totals__net {
    color: var(--site-accent-green-deep);
  }

  .grid :global(th[scope='row']) {
    font-weight: 600;
    text-align: left;
  }

  .note {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--site-color-text-muted);
  }

  @media (max-width: 1299px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 1099px) {
    .row,
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 599px) {
    .stats,
    .totals {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
