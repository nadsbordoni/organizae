---
import PanelLayout from '@/layouts/PanelLayout.astro';
import ActionButton from '@/components/ActionButton.astro';
import EmptyState from '@/components/EmptyState.astro';
import DayList from '@/components/painel/DayList.astro';
import FinanceChart from '@/components/painel/FinanceChart.astro';
import PanelHeading from '@/components/painel/PanelHeading.astro';
import PanelSection from '@/components/painel/PanelSection.astro';
import StatCard from '@/components/painel/StatCard.astro';
import { getSite } from '@/config';
import { formatPrice, nowInBusinessTime, parsePrice } from '@/lib/agenda';
import { forTenant, resumoDemonstracao, usuarioExemplo } from '@/lib/dados-exemplo';
import { compactPrice, firstName, lastMonths, tenantNotConfigured, weekdayLabel } from '@/lib/painel';

/**
 * Visão geral do painel (quadro 05 do protótipo). Topo, gráfico, serviços mais agendados e assistente
 * são DEMONSTRAÇÃO (`resumoDemonstracao`) e não batem com a agenda; só a "Agenda de hoje" é real.
 * Trocar pelo resumo da API.
 */
export const prerender = false;

const user = usuarioExemplo;
const site = getSite(user.tenantSlug);
if (!site) return tenantNotConfigured(user.tenantSlug);

const agenda = site.agenda;
const hoje = nowInBusinessTime(agenda?.timezone ?? 'America/Sao_Paulo').date;

const dados = forTenant(user.tenantSlug);
const doDia = (await dados.appointmentsOn(hoje)).filter((m) => m.status !== 'cancelled');
const nome = firstName(user.name);

const resumo = resumoDemonstracao;
const percent = (value: number) => `${value.toLocaleString('pt-BR')}%`;

const months = lastMonths(hoje, resumo.movimento.length);
const mesAnterior = months.at(-2)!.long;

const catalogo = new Map((agenda?.categories ?? []).flatMap((c) => c.services.map((s) => [s.id, s] as const)));
const maisAgendados = resumo.servicosMaisAgendados.flatMap(({ id, agendamentos }) => {
  const service = catalogo.get(id);
  const price = parsePrice(service?.price);
  if (!service || price === undefined) return [];
  return [{ name: service.name, agendamentos, value: compactPrice(formatPrice(price * agendamentos)) }];
});
// A barra mais cheia não encosta no fim, como no protótipo.
const topo = Math.max(...maisAgendados.map((s) => s.agendamentos)) * 1.1;
---

<PanelLayout site={site} user={user} current="home" title="Visão geral">
  <PanelHeading
    eyebrow={weekdayLabel(hoje)}
    title={nome ? `Olá, ${nome}!` : 'Olá!'}
    intro="Aqui está um resumo do que está acontecendo hoje."
  >
    {/* PROTÓTIPO: os dois botões ainda não fazem nada. */}
    <ActionButton label="Exportar" variant="secondary" icon="download" iconPosition="end" full={false} />
    <ActionButton label="Novo agendamento" icon="plus" iconPosition="end" full={false} />
  </PanelHeading>

  <div class="stats">
    <StatCard
      label="Faturamento no mês"
      value={compactPrice(formatPrice(resumo.faturamentoCentavos))}
      note={`+${percent(resumo.variacaoFaturamento)} comparado a ${mesAnterior}`}
      tone="pink"
    />
    <StatCard
      label="Agendamentos"
      value={String(resumo.agendamentos)}
      note={`${percent(resumo.ocupacao)} de ocupação`}
      tone="yellow"
    />
    <StatCard label="Novos clientes" value={String(resumo.novosClientes)} note={`+${resumo.novosNoMes} neste mês`} tone="blue" />
    <StatCard
      label="Valor médio por agendamento"
      value={formatPrice(Math.round(resumo.faturamentoCentavos / resumo.agendamentos))}
      note={`Receita ÷ ${resumo.agendamentos} agendamentos`}
      tone="green"
    />
  </div>

  <div class="grid">
    <PanelSection
      title="Movimento financeiro"
      subtitle={`Receitas e despesas • ${months.length} meses`}
      id="titulo-movimento"
    >
      <span class="chip" slot="aside">Últimos {months.length} meses</span>
      <FinanceChart
        months={months.map((m) => m.short)}
        series={resumo.movimento}
        label={`Receitas e despesas dos últimos ${months.length} meses`}
      />
    </PanelSection>

    <PanelSection
      title="Agenda de hoje"
      subtitle={doDia.length === 1 ? '1 horário' : `${doDia.length} horários`}
      id="titulo-hoje"
    >
      <ActionButton slot="aside" label="Ver agenda" variant="secondary" href="/painel/agenda" full={false} />
      {
        doDia.length ? (
          <DayList rows={doDia.slice(0, 4)} agenda={agenda} label="Atendimentos de hoje" idPrefix="det-hoje" />
        ) : (
          <EmptyState
            level={3}
            mascot="relaxando"
            title="Nenhum atendimento hoje"
            text="Um bom dia para organizar o resto da semana."
          />
        )
      }
    </PanelSection>

    <section class="assist" aria-labelledby="titulo-assistente">
      <h2 class="assist__label" id="titulo-assistente">Assistente Organizaê</h2>
      <p class="assist__title">Seu melhor mês até agora.</p>
      <p class="assist__text">
        O faturamento cresceu {percent(resumo.variacaoFaturamento)} e a taxa de retorno chegou a {percent(resumo.taxaRetorno)}.
      </p>
      {/* PROTÓTIPO: sem ação. */}
      <button class="assist__button" type="button">Ver análise completa</button>
      <span class="assist__mascot" aria-hidden="true">
        <img src="/marca/mascote-tablet.webp" alt="" width="465" height="720" loading="lazy" />
      </span>
    </section>

    <PanelSection title="Serviços mais agendados" subtitle="Valores dos agendamentos" id="titulo-servicos">
      {/* PROTÓTIPO: a tela de Serviços ainda não existe. */}
      <button class="link" slot="aside" type="button">Ver serviços</button>
      <ol class="rank">
        {
          maisAgendados.map((s, i) => (
            <li class="rank__row">
              <span class="rank__pos" aria-hidden="true">{i + 1}</span>
              <span class="rank__who">
                <strong>{s.name}</strong>
                <span>{s.agendamentos} agendamentos</span>
              </span>
              <span class="rank__bar" aria-hidden="true">
                <span style={`width: ${Math.round((s.agendamentos / topo) * 100)}%`} />
              </span>
              <span class="rank__value">{s.value}</span>
            </li>
          ))
        }
      </ol>
    </PanelSection>
  </div>
</PanelLayout>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 36px;
  }

  /* Proporção medida no protótipo, a mesma nas duas linhas de baixo. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.94fr) minmax(0, 1fr);
    gap: 16px;
    margin-top: 16px;
  }

  .chip {
    padding: 4px 14px;
    border-radius: 999px;
    background: var(--site-color-brand-soft);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .link {
    min-height: 44px;
    padding: 0 4px;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--site-color-text);
    cursor: pointer;
  }


  .rank__who {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }

  .rank__who strong {
    font-size: 1rem;
    font-weight: 600;
  }

  .rank__who span {
    font-size: 0.875rem;
    color: var(--site-color-text-muted);
  }

  .assist {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 320px;
    padding: 36px;
    border-radius: var(--site-radius-card);
    background: var(--site-panel-sidebar);
    color: var(--site-panel-on-sidebar);
    overflow: hidden;
  }

  .assist__label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .assist__title {
    margin-top: 32px;
    max-width: 60%;
    font-family: var(--site-font-display);
    font-size: 1.875rem;
    font-weight: var(--site-font-display-weight);
    letter-spacing: var(--site-font-display-tracking);
    line-height: 1.15;
  }

  .assist__text {
    margin-top: 20px;
    max-width: 60%;
    font-size: 0.875rem;
    color: var(--site-panel-on-sidebar-muted);
  }

  .assist__button {
    margin-top: 24px;
    min-height: 52px;
    padding: 0 24px;
    border: 0;
    border-radius: var(--site-radius-button);
    background: var(--site-color-surface);
    color: var(--site-color-text);
    font: inherit;
    font-size: 1rem;
    font-weight: 650;
    cursor: pointer;
  }

  .assist__button:focus-visible {
    outline: 2px solid var(--site-panel-sidebar-accent);
    outline-offset: 3px;
  }

  .assist__mascot {
    position: absolute;
    right: 18px;
    bottom: -30px;
    display: grid;
    place-items: center;
    width: 190px;
    height: 230px;
    border-radius: 50% 50% 0 0 / 40% 40% 0 0;
    background: var(--site-background-page-solid);
  }

  .assist__mascot img {
    height: 180px;
    width: auto;
  }

  .rank {
    display: flex;
    flex-direction: column;
    gap: 22px;
    list-style: none;
    padding-top: 10px;
  }

  .rank__row {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) minmax(60px, 120px) auto;
    align-items: center;
    gap: 14px;
  }

  .rank__pos {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--site-color-brand-soft);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .rank__bar {
    height: 6px;
    border-radius: 999px;
    background: var(--site-color-brand-soft);
    overflow: hidden;
  }

  .rank__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--site-accent-green);
  }

  .rank__value {
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 1299px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 1099px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 599px) {
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }

    .assist {
      padding: 28px 24px 200px;
    }

    .assist__title,
    .assist__text {
      max-width: none;
    }
  }
</style>
