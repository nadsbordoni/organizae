---
import AuthLayout from '@/layouts/AuthLayout.astro';
import ActionButton from '@/components/ActionButton.astro';
import Heading from '@/components/Heading.astro';
import TextField from '@/components/TextField.astro';
import { BUSINESS_SEGMENTS } from '@/lib/painel';

/** Cadastro, passo 2 (quadro 01). Com a API: `POST /api/v1/businesses`. */
---

<AuthLayout title="Sobre o negócio" mascot="lojinha">
  <Heading
    eyebrow="Sobre o seu negócio"
    title="Conte um pouco sobre a empresa"
    intro="Essas informações serão usadas no seu painel e na página pública."
  />

  <form class="auth-form" method="post" action="/painel/cadastro/pronto" data-prototype>
    <TextField
      id="negocio"
      label="Nome do negócio"
      autocomplete="organization"
      placeholder="Ex.: Studio Aurora"
      required
      autofocus
    />
    <TextField id="categoria" label="Categoria" options={BUSINESS_SEGMENTS} required />
    <div class="auth-row">
      <TextField id="documento" label="CNPJ ou CPF" placeholder="00.000.000/0000-00" required />
      <TextField id="cidade" label="Cidade" autocomplete="address-level2" placeholder="Ex.: Recife" required />
    </div>
    <div class="auth-actions">
      <ActionButton label="Voltar" variant="secondary" href="/painel/cadastro" full={false} />
      <ActionButton label="Criar meu espaço" type="submit" />
    </div>
  </form>
</AuthLayout>
