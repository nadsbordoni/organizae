---
import AuthLayout from '@/layouts/AuthLayout.astro';
import ActionButton from '@/components/ActionButton.astro';
import Heading from '@/components/Heading.astro';
import IconBadge from '@/components/IconBadge.astro';

/** Cadastro concluído (quadro 01). */
---

<AuthLayout title="Conta criada">
  <IconBadge icon="check" />
  <Heading
    eyebrow="Tudo certo"
    title="Sua conta foi criada!"
    intro="Agora vamos personalizar o Organizaê para deixar tudo com a cara do seu negócio."
  />
  <div class="auth-form">
    {/* PROTÓTIPO: a configuração inicial (quadro 03) ainda não existe; por ora leva ao painel. */}
    <ActionButton label="Personalizar meu espaço" icon="sparkles" iconPosition="end" href="/painel" />
  </div>
</AuthLayout>
