---
import AuthLayout from '@/layouts/AuthLayout.astro';
import ActionButton from '@/components/ActionButton.astro';
import BackLink from '@/components/BackLink.astro';
import Heading from '@/components/Heading.astro';
import PasswordField from '@/components/PasswordField.astro';
import TextField from '@/components/TextField.astro';

/** Cadastro, passo 1 (quadro 01). Com a API: `POST /api/v1/users` e depois `POST /api/v1/auth/login`. */
---

<AuthLayout title="Criar acesso">
  <Heading
    eyebrow="Primeiro passo"
    title="Vamos criar seu acesso"
    intro="Em poucos minutos sua operação estará pronta para receber clientes."
  />

  <form class="auth-form" method="post" action="/painel/cadastro/empresa" data-prototype>
    <TextField
      id="nome"
      label="Nome completo"
      autocomplete="name"
      placeholder="Como podemos chamar você?"
      required
      autofocus
    />
    <TextField id="email" label="E-mail" type="email" autocomplete="email" placeholder="voce@empresa.com.br" required />
    <TextField id="telefone" label="Telefone" type="tel" autocomplete="tel" placeholder="(00) 00000-0000" required />
    <PasswordField id="senha" label="Crie uma senha" autocomplete="new-password" placeholder="8 ou mais caracteres" rules />
    <ActionButton label="Continuar" type="submit" />
    <BackLink href="/painel/login" label="Voltar para entrar" />
  </form>
</AuthLayout>
