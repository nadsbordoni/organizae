---
import AuthLayout from '@/layouts/AuthLayout.astro';
import ActionButton from '@/components/ActionButton.astro';
import BackLink from '@/components/BackLink.astro';
import FormAlert from '@/components/FormAlert.astro';
import Heading from '@/components/Heading.astro';
import PasswordField from '@/components/PasswordField.astro';
import TextField from '@/components/TextField.astro';
import { apiEnabled } from '@/lib/api';
import { startSession } from '@/lib/session';
import { accountError, createAccount, rememberPhone } from '@/lib/signup';

/** Cadastro, passo 1 (quadro 01): cria a conta (`POST /users`), já entra e segue para o negócio. */
export const prerender = false;

const NEXT_STEP = '/painel/cadastro/empresa';

// Quem já entrou não cria outra conta: termina o cadastro ou vai para o painel.
if (apiEnabled() && Astro.locals.token) {
  return Astro.redirect(Astro.locals.user.businessId ? '/painel' : NEXT_STEP, 303);
}

let erro: string | undefined;
const valores = { nome: '', email: '', telefone: '' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  valores.nome = String(form.get('nome') ?? '').trim();
  valores.email = String(form.get('email') ?? '').trim().toLowerCase();
  valores.telefone = String(form.get('telefone') ?? '').trim();
  const password = String(form.get('senha') ?? '');

  // Demonstração sem API: só avança, como no protótipo.
  if (!apiEnabled()) return Astro.redirect(NEXT_STEP, 303);

  try {
    const token = await createAccount({ name: valores.nome, email: valores.email, password });
    const secure = Astro.url.protocol === 'https:';
    startSession(Astro.cookies, token, { remember: false, secure });
    rememberPhone(Astro.cookies, valores.telefone, secure);
    return Astro.redirect(NEXT_STEP, 303);
  } catch (error) {
    console.error('Falha ao criar a conta', error);
    erro = accountError(error);
    Astro.response.status = 422;
  }
}
---

<AuthLayout title="Criar acesso" mascot="prancheta">
  <Heading
    eyebrow="Primeiro passo"
    title="Vamos criar seu acesso"
    intro="Em poucos minutos sua operação estará pronta para receber clientes."
  />

  {erro && <FormAlert message={erro} />}

  {/* Envia para esta mesma página, no servidor: a senha nunca passa pela URL. */}
  <form class="auth-form" method="post">
    <TextField
      id="nome"
      label="Nome completo"
      autocomplete="name"
      placeholder="Como podemos chamar você?"
      value={valores.nome}
      maxlength={150}
      required
      autofocus
    />
    <TextField
      id="email"
      label="E-mail"
      type="email"
      autocomplete="email"
      placeholder="voce@empresa.com.br"
      value={valores.email}
      maxlength={255}
      required
    />
    <TextField
      id="telefone"
      label="Telefone"
      type="tel"
      autocomplete="tel"
      placeholder="(00) 00000-0000"
      value={valores.telefone}
      pattern="[0-9\(\)+ \-]{10,20}"
      title="Só números, com DDD. Ex.: (81) 99999-9999"
      required
    />
    <PasswordField id="senha" label="Crie uma senha" autocomplete="new-password" placeholder="8 ou mais caracteres" rules />
    <ActionButton label="Continuar" type="submit" />
    <BackLink href="/painel/login" label="Voltar para entrar" />
  </form>
</AuthLayout>
