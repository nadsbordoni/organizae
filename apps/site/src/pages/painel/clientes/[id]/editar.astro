---
import PanelLayout from '@/layouts/PanelLayout.astro';
import FormAlert from '@/components/FormAlert.astro';
import ClientForm from '@/components/painel/ClientForm.astro';
import PanelHeading from '@/components/painel/PanelHeading.astro';
import { getSite } from '@/config';
import { clientData, clientError, draftClient, readClientForm, saveClient } from '@/lib/clients-api';
import { tenantNotConfigured } from '@/lib/painel';

/** Edição do cadastro, aberta pela ficha. Com a API: `PATCH /clients/{id}`. */
export const prerender = false;

const user = Astro.locals.user;
const site = getSite(user.tenantSlug);
if (!site) return tenantNotConfigured(user.tenantSlug);

const { live, dados } = await clientData(Astro.locals.token, user.tenantSlug, site.agenda);
let client = await dados.client(Astro.params.id ?? '');
if (!client) return new Response(null, { status: 404 });

const profile = `/painel/clientes/${client.id}`;
let erro: string | undefined;

if (live && Astro.request.method === 'POST') {
  const input = readClientForm(await Astro.request.formData());
  try {
    await saveClient(Astro.locals.token!, input, client.id);
    return Astro.redirect(`${profile}?salvo`, 303);
  } catch (error) {
    console.error('Falha ao salvar o cliente', error);
    erro = clientError(error);
    client = draftClient(input, client);
    Astro.response.status = 422;
  }
}
---

<PanelLayout site={site} user={user} current="clientes" title={`Editar ${client.name}`}>
  <PanelHeading eyebrow="Clientes · Editar cadastro" title={client.name} intro="Atualize os dados de contato e as preferências." />
  {erro && <FormAlert message={erro} />}
  <ClientForm
    action={live ? `${profile}/editar` : `${profile}?salvo`}
    cancelHref={profile}
    submitLabel="Salvar alterações"
    businessName={site.profile.name}
    client={client}
    live={live}
  />
</PanelLayout>
