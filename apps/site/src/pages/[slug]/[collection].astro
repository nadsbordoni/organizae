---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageContainer from '@/components/PageContainer.astro';
import BusinessMark from '@/components/BusinessMark.astro';
import Heading from '@/components/Heading.astro';
import IconButton from '@/components/IconButton.astro';
import ProductCard from '@/components/ProductCard.astro';
import Disclosure from '@/components/Disclosure.astro';
import Footer from '@/components/Footer.astro';
import { assertDisclosure } from '@/lib/disclosure';
import { BOOKING_PATH } from '@/lib/blocks';
import { sites } from '@/config';
import type { Collection, SiteConfig } from '@/types/site';

/**
 * Página de coleção `/{slug}/{coleção}`. Sem cabeçalho de perfil de propósito: a barra
 * do topo já nomeia o negócio, e dois títulos grandes seguidos competiriam.
 */
export function getStaticPaths() {
  return sites.flatMap((site) =>
    (site.collections ?? []).map((collection) => {
      // `/{slug}/agendar` é rota estática e tiraria esta coleção do ar em silêncio: melhor não compilar.
      if (collection.slug === BOOKING_PATH) {
        throw new Error(
          `Site "${site.slug}": a coleção "${BOOKING_PATH}" colide com a rota de ` +
            'agendamento. Escolha outro slug para a coleção.',
        );
      }

      return {
        params: { slug: site.slug, collection: collection.slug },
        props: { site, collection },
      };
    }),
  );
}

interface Props {
  site: SiteConfig;
  collection: Collection;
}

const { site, collection }: Props = Astro.props;

const seo = {
  ...site.seo,
  title: `${collection.title} • ${site.profile.name}`,
  description: collection.intro ?? `${collection.title} — ${site.profile.name}`,
};

assertDisclosure(collection.items, collection.disclosure, `coleção "${collection.slug}" de ${site.slug}`);

const hasBadges = collection.items.some((item) => item.badge);
---

<SiteLayout theme={site.theme} seo={seo} noindex={site.seo?.noindex}>
  <PageContainer as="main" id="conteudo" wide>
    <nav class="bar" aria-label="Navegação">
      <IconButton href={`/${site.slug}`} label={`Voltar para ${site.profile.name}`} icon="chevron-left" />
      <p class="bar__who">
        <strong>{site.profile.name}</strong>
        <span>Produtos selecionados</span>
      </p>
      <BusinessMark profile={site.profile} size={42} />
    </nav>

    <Heading eyebrow={collection.eyebrow} title={collection.title} intro={collection.intro} />

    <ul class="collection__items">
      {collection.items.map((item) => <ProductCard item={item} reserveBadge={hasBadges} />)}
    </ul>

    {collection.disclosure && <Disclosure text={collection.disclosure} />}

    <Footer note={site.footerNote} />
  </PageContainer>
</SiteLayout>

<style>
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 64px;
  }

  .bar__who {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .bar__who strong {
    font-size: 1rem;
    font-weight: 600;
  }

  .bar__who span {
    font-size: 0.75rem;
    color: var(--site-color-text-muted);
  }

  .collection__items {
    /* O mínimo da coluna nunca passa de metade da linha: duas colunas no celular. */
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(220px, calc(50% - 8px)), 1fr));
    gap: 16px;
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }

  @media (max-width: 430px) {
    .bar {
      margin-bottom: 36px;
    }

    .collection__items {
      gap: 12px;
    }
  }
</style>
