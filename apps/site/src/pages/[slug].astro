---
import LinkPage from '@/components/LinkPage.astro';
import { getSite } from '@/config';
import { fetchPublicPage, toSiteConfig } from '@/lib/public-page';

/**
 * Página de links `/{slug}`. Gerada a cada acesso: a página publicada no painel aparece na hora,
 * sem novo build. Continua com título e imagem de preview próprios no WhatsApp/Instagram.
 * Primeiro os estúdios de `src/config/sites/`; se o slug não estiver lá, a página publicada na API.
 */
export const prerender = false;

const slug = Astro.params.slug ?? '';
const configured = getSite(slug);
const published = configured ? null : await fetchPublicPage(slug);
const site = configured ?? (published ? toSiteConfig(published) : undefined);

if (!site) {
  return Astro.rewrite('/404');
}
---

<LinkPage site={site} />
