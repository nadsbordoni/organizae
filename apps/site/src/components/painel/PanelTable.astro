---
/**
 * Tabela do painel. Quem usa escreve `<thead>` e `<tbody>`; o estilo vem daqui.
 * Em tela estreita cada linha vira um bloco, sem rolagem horizontal.
 */
interface Props {
  /** Legenda para leitor de tela. */
  label: string;
}

const { label } = Astro.props;
---

<div class="table">
  <table>
    <caption class="sr-only">{label}</caption>
    <slot />
  </table>
</div>

<style>
  .table {
    border-radius: var(--site-radius-card);
    border: 1px solid var(--site-color-border);
    background: var(--site-color-surface);
    box-shadow: var(--site-shadow-resting);
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  .table :global(th) {
    padding: 14px 24px;
    background: var(--site-panel-background);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-align: left;
    text-transform: uppercase;
    color: var(--site-color-text-muted);
  }

  .table :global(td) {
    padding: 18px 24px;
    border-top: 1px solid var(--site-color-border);
    vertical-align: middle;
  }

  @media (max-width: 719px) {
    .table :global(thead) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .table :global(tr) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px 16px;
      padding: 16px 18px;
      border-top: 1px solid var(--site-color-border);
    }

    .table :global(tbody tr:first-child) {
      border-top: 0;
    }

    .table :global(td) {
      padding: 0;
      border-top: 0;
    }
  }
</style>
