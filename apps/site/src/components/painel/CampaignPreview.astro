---
import PanelTable from './PanelTable.astro';
import type { ClientSummary } from '@/lib/clients';
import { numericDate } from '@/lib/painel';

/**
 * A campanha como a dona vai aprovar: nome, canal, prévia da mensagem para a primeira cliente e a lista
 * de destinatários. O nome e o texto editados na tela anterior entram pelo script (`data-campaign-*`).
 */
interface Props {
  name: string;
  message: string;
  recipients: ClientSummary[];
  business: string;
  approved?: boolean;
}

const { name, message, recipients, business, approved = false } = Astro.props;
const first = recipients[0];
const firstName = first?.client.name.split(' ')[0] ?? '';
---

<section class="campaign" aria-labelledby="titulo-campanha">
  <h2 id="titulo-campanha" data-campaign-name>{name}</h2>
  <p class="campaign__sub">Campanha de recuperação de clientes ausentes</p>
  <p class="campaign__chips">
    <span class="chip chip--blue">WhatsApp</span>
    <span class="chip chip--pink">{recipients.length} {recipients.length === 1 ? 'destinatário' : 'destinatários'}</span>
    <span class={approved ? 'chip chip--green' : 'chip chip--yellow'}>{approved ? 'Aprovada' : 'Em revisão'}</span>
  </p>

  {
    first && (
      <>
        <h3>Prévia para {first.client.name}</h3>
        <div class="bubble">
          <p data-campaign-message data-first-name={firstName}>
            {message.replaceAll('{primeiro_nome}', firstName)}
          </p>
          <small>{business} · Canal WhatsApp</small>
        </div>
      </>
    )
  }

  <PanelTable label="Destinatários da campanha">
    <thead>
      <tr>
        <th scope="col">Destinatário</th>
        <th scope="col" data-wide>
          Último atendimento
        </th>
        <th scope="col">Critério</th>
      </tr>
    </thead>
    <tbody>
      {
        recipients.map((s) => (
          <tr>
            <td class="strong">{s.client.name}</td>
            <td data-wide>{s.lastVisit ? numericDate(s.lastVisit) : '—'}</td>
            <td>{s.daysAway === undefined ? 'Sem atendimentos' : `${s.daysAway} dias`} · Elegível</td>
          </tr>
        ))
      }
    </tbody>
  </PanelTable>
  <p class="campaign__foot">{recipients.length} selecionados no total.</p>
</section>

<script>
  import { readAccount } from '@/lib/prototype-form';

  // O que a dona escreveu na tela anterior fica na sessão do navegador; sem nada, vale o texto inicial.
  const stored = readAccount();
  const name = document.querySelector<HTMLElement>('[data-campaign-name]');
  const message = document.querySelector<HTMLElement>('[data-campaign-message]');
  if (name && typeof stored.campanha === 'string' && stored.campanha) name.textContent = stored.campanha;
  if (message && typeof stored.mensagem === 'string' && stored.mensagem) {
    message.textContent = stored.mensagem.replaceAll('{primeiro_nome}', message.dataset.firstName ?? '');
  }
</script>

<style>
  .campaign {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border-radius: var(--site-radius-card);
    border: 1px solid var(--site-color-border);
    background: var(--site-color-surface);
  }

  .campaign h2 {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .campaign__sub,
  .campaign__foot {
    font-size: 0.8125rem;
    color: var(--site-color-text-muted);
  }

  .campaign__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .chip--blue {
    background: var(--site-accent-blue-soft);
  }

  .chip--pink {
    background: var(--site-accent-pink-soft);
  }

  .chip--yellow {
    background: var(--site-accent-yellow-soft);
  }

  .chip--green {
    background: var(--site-panel-positive-soft);
    color: var(--site-accent-green-deep);
  }

  .campaign h3 {
    margin-top: 4px;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  /* Balão no verde claro do WhatsApp, como no protótipo. */
  .bubble {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--site-accent-green) 22%, var(--site-color-surface));
  }

  .bubble p {
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .bubble small {
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--site-color-text-muted) 80%, var(--site-color-text));
  }

  .strong {
    font-weight: 600;
  }
</style>
