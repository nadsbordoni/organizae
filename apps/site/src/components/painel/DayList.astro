---
import Icon from '@/components/Icon.astro';
import AppointmentDetails from './AppointmentDetails.astro';
import Initials from './Initials.astro';
import StatusBadge from './StatusBadge.astro';
import { whatsappUrl } from '@/lib/links';
import { STATUS_BADGE, serviceNames } from '@/lib/painel';
import type { Agenda } from '@/types/agenda';
import type { AppointmentRow } from '@/types/painel';

/**
 * Atendimentos de um dia em lista. Enxuta na "Agenda de hoje", como no protótipo;
 * `detailed` na Agenda, com duração, selo colorido e WhatsApp.
 */
interface Props {
  rows: AppointmentRow[];
  agenda?: Agenda;
  label: string;
  detailed?: boolean;
  /** Prefixo dos ids dos detalhes: a mesma marcação pode aparecer duas vezes na página. */
  idPrefix: string;
}

const { rows, agenda, label, detailed = false, idPrefix } = Astro.props;
---

<ul class="day" aria-label={label} data-detailed={detailed ? '' : undefined}>
  {
    rows.map((row) => (
      <li class="day__row">
        <span class="day__time">
          <strong>{row.start_time}</strong>
          {detailed && <small>{row.duration_min} min</small>}
        </span>
        <Initials name={row.client_name} />
        <button class="day__who" type="button" popovertarget={`${idPrefix}-${row.id}`}>
          <strong>{row.client_name}</strong>
          <span>{serviceNames(row, agenda)}</span>
        </button>
        <AppointmentDetails id={`${idPrefix}-${row.id}`} row={row} agenda={agenda} />
        {detailed ? (
          <StatusBadge {...STATUS_BADGE[row.status]} />
        ) : (
          <span class="day__status">{STATUS_BADGE[row.status].label}</span>
        )}
        {detailed && (
          <span class="day__contact">
            {row.client_phone && (
              <a
                href={whatsappUrl(row.client_phone)}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Falar com ${row.client_name} no WhatsApp`}
              >
                <Icon name="whatsapp" size={18} />
              </a>
            )}
          </span>
        )}
      </li>
    ))
  }
</ul>

<style>
  .day {
    list-style: none;
  }

  .day__row {
    display: grid;
    grid-template-columns: 52px 36px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--site-color-border);
  }

  .day[data-detailed] .day__row {
    grid-template-columns: 64px 36px minmax(0, 1fr) auto 40px;
  }

  .day__row:last-child {
    border-bottom: 0;
  }

  .day__time {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .day__time strong {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .day__time small {
    font-size: 0.75rem;
    color: var(--site-color-text-muted);
  }

  .day__who {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 44px;
    justify-content: center;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
  }

  .day__who:hover strong {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .day__who:focus-visible {
    outline: 3px solid var(--site-color-brand-deep);
    outline-offset: 2px;
    border-radius: 6px;
  }

  .day__who strong {
    font-size: 1rem;
    font-weight: 600;
  }

  .day__who span {
    font-size: 0.875rem;
    color: var(--site-color-text-muted);
  }

  .day__status {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .day__contact a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    color: var(--site-color-text);
  }

  .day__contact a:hover {
    background: var(--site-color-brand-soft);
  }

  .day__contact a:focus-visible {
    outline: 3px solid var(--site-color-brand-deep);
    outline-offset: 2px;
  }

  /* Celular: a situação desce para baixo do nome, para o nome não espremer. */
  @media (max-width: 599px) {
    .day__row,
    .day[data-detailed] .day__row {
      grid-template-columns: 48px 36px minmax(0, 1fr) auto;
    }

    .day[data-detailed] :global(.badge) {
      grid-column: 3;
      justify-self: start;
    }

    .day[data-detailed] .day__contact {
      grid-column: 4;
      grid-row: 1;
    }
  }
</style>
