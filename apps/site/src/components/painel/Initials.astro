---
import { initials, toneFor } from '@/lib/painel';

/** Inicial de uma pessoa num círculo colorido, como no protótipo. Decorativa: o nome está sempre ao lado. */
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<span class="initials" style={`--tone: var(--site-accent-${toneFor(name)})`} aria-hidden="true">
  {initials(name).charAt(0)}
</span>

<style>
  .initials {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--tone);
    color: var(--site-color-text);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
</style>
