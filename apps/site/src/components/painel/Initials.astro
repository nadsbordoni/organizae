---
import { initials, toneFor } from '@/lib/painel';

/**
 * Iniciais de uma pessoa num selo colorido, como no protótipo. Decorativas: o nome está sempre ao lado.
 * Nas listas, uma letra num círculo; `large` é o quadrado com duas letras da ficha do cliente.
 */
interface Props {
  name: string;
  large?: boolean;
}

const { name, large = false } = Astro.props;
---

<span
  class="initials"
  data-large={large ? '' : undefined}
  style={`--tone: var(--site-accent-${toneFor(name)})`}
  aria-hidden="true"
  data-initials
>
  {large ? initials(name) : initials(name).charAt(0)}
</span>

<style>
  .initials {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--tone);
    color: var(--site-color-text);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .initials[data-large] {
    width: 72px;
    height: 72px;
    border-radius: 14px;
    font-size: 1.0625rem;
  }
</style>
