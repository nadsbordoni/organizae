---
/** Cartão de seção do painel: título, subtítulo e, à direita, uma ação. */
interface Props {
  title: string;
  subtitle?: string;
  /** Id do título, para o `aria-labelledby` da seção. */
  id: string;
}

const { title, subtitle, id } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="section" aria-labelledby={id}>
  <header class="section__head">
    <div>
      <h2 class="section__title" id={id}>{title}</h2>
      {subtitle && <p class="section__subtitle">{subtitle}</p>}
    </div>
    {hasAside && <div class="section__aside"><slot name="aside" /></div>}
  </header>

  <slot />
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px;
    border-radius: var(--site-radius-card);
    border: 1px solid var(--site-color-border);
    background: var(--site-color-surface);
  }

  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px 16px;
  }

  .section__title {
    font-size: 1.1875rem;
    font-weight: 600;
    color: var(--site-color-text);
  }

  .section__subtitle {
    margin-top: 4px;
    font-size: 0.875rem;
    color: var(--site-color-text-muted);
  }

  .section__aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  @media (max-width: 719px) {
    .section {
      padding: 20px;
    }
  }
</style>
