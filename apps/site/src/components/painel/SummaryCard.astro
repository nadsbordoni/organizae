---
import Icon from '@/components/Icon.astro';
import type { IconName } from '@/types/blocks';
import type { PanelTone } from '@/lib/painel';

/** Um número do resumo, com rótulo, ícone e a barra na cor do estado. */
interface Props {
  label: string;
  value: string;
  note?: string;
  icon: IconName;
  tone: PanelTone;
  /** 0 a 1 vira barra de progresso. Ausente, a barra é só a cor do cartão. */
  progress?: number;
}

const { label, value, note, icon, tone, progress } = Astro.props;
const fill = progress === undefined ? 100 : Math.round(Math.min(Math.max(progress, 0), 1) * 100);
---

<article
  class="summary"
  style={`--tone: var(--site-panel-${tone}); --tone-soft: var(--site-panel-${tone}-soft)`}
>
  <div class="summary__top">
    <h3 class="summary__label">{label}</h3>
    <span class="summary__icon"><Icon name={icon} size={22} /></span>
  </div>

  <div class="summary__body">
    <p class="summary__value">{value}</p>
    {note && <p class="summary__note">{note}</p>}
  </div>

  {/* O número já está em texto; a barra é reforço visual. */}
  <span class="summary__bar" aria-hidden="true">
    <span class="summary__fill" style={`width: ${fill}%`}></span>
  </span>
</article>

<style>
  .summary {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: var(--site-radius-card);
    border: 1px solid var(--site-color-border);
    background: var(--site-color-surface);
    box-shadow: var(--site-shadow-resting);
  }

  .summary__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .summary__label {
    padding-top: 10px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--site-color-text);
  }

  .summary__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--tone);
    color: var(--site-color-text);
  }

  /* Cresce para alinhar as barras dos cartões vizinhos, com notas de tamanhos diferentes. */
  .summary__body {
    flex: 1;
    margin-top: 18px;
  }

  .summary__value {
    font-size: clamp(1.75rem, 2.6vw, 2.125rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--site-color-text);
  }

  .summary__note {
    margin-top: 6px;
    font-size: 0.8125rem;
    color: var(--site-color-text-muted);
  }

  .summary__bar {
    display: block;
    height: 5px;
    margin-top: 20px;
    border-radius: 999px;
    background: var(--tone-soft);
    overflow: hidden;
  }

  .summary__fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--tone);
  }
</style>
