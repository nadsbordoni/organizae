---
import BusinessMark from './BusinessMark.astro';

/**
 * Logo do negócio com prévia. Sem logo, mostra as iniciais do campo de nome indicado em `nameInput`.
 * PROTÓTIPO: o arquivo não sobe para lugar nenhum; com a API, vira o `logo_url` do negócio.
 */
interface Props {
  /** Id do campo de nome que alimenta as iniciais. */
  nameInput: string;
  /** Nome inicial das iniciais, antes de qualquer digitação. */
  name?: string;
}

const { nameInput, name = 'Seu negócio' } = Astro.props;
---

<div class="logo" data-logo data-name-input={nameInput}>
  <BusinessMark profile={{ name }} size={80} />
  <div class="logo__text">
    <strong>Logo do negócio</strong>
    <small id={`${nameInput}-logo-regra`}>PNG, JPG ou SVG. Máximo de 5 MB.</small>
    <label class="logo__pick">
      Escolher arquivo
      <input
        class="sr-only"
        type="file"
        name="logo"
        accept="image/png,image/jpeg,image/svg+xml"
        aria-describedby={`${nameInput}-logo-regra`}
        data-logo-input
      />
    </label>
    <p class="logo__error" role="alert" hidden data-logo-error>O arquivo passa de 5 MB. Escolha um menor.</p>
  </div>
</div>

<script>
  import { initials } from '@/lib/painel';

  const MAX = 5 * 1024 * 1024;

  for (const root of document.querySelectorAll<HTMLElement>('[data-logo]')) {
    const mark = root.querySelector<HTMLElement>('.mark');
    const name = document.getElementById(root.dataset.nameInput ?? '') as HTMLInputElement | null;
    const file = root.querySelector<HTMLInputElement>('[data-logo-input]');
    const error = root.querySelector<HTMLElement>('[data-logo-error]');

    const showInitials = () => {
      if (mark && !mark.style.backgroundImage) mark.textContent = initials(name?.value.trim() || 'Seu negócio');
    };
    name?.addEventListener('input', showInitials);
    showInitials();

    file?.addEventListener('change', () => {
      const chosen = file.files?.[0];
      if (!chosen || !mark || !error) return;
      const tooBig = chosen.size > MAX;
      error.hidden = !tooBig;
      file.setCustomValidity(tooBig ? 'O arquivo passa de 5 MB.' : '');
      if (tooBig) return;
      mark.style.backgroundImage = `url(${URL.createObjectURL(chosen)})`;
      mark.textContent = '';
    });
  }
</script>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px;
    border-radius: var(--site-radius-card);
    border: 1px solid var(--site-color-border);
    background: var(--site-color-surface);
  }

  .logo :global(.mark) {
    background-size: cover;
    background-position: center;
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .logo__text strong {
    font-size: 1rem;
    font-weight: 600;
  }

  .logo__text small {
    font-size: 0.75rem;
    color: var(--site-color-text-muted);
  }

  .logo__pick {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 8px;
    padding: 0 20px;
    border-radius: var(--site-radius-button);
    border: 1px solid var(--site-color-border-strong);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .logo__pick:hover {
    background: var(--site-color-brand-soft);
  }

  .logo__pick:focus-within {
    outline: 3px solid var(--site-color-brand-deep);
    outline-offset: 2px;
  }

  .logo__error {
    font-size: 0.8125rem;
    color: var(--site-color-error);
  }
</style>
