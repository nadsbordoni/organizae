---
/**
 * Aviso de publicidade no fim da página com link de afiliado. Componente próprio
 * para home e coleção mostrarem o MESMO aviso.
 */

interface Props {
  text: string;
}

const { text }: Props = Astro.props;
---

<p class="disclosure">{text}</p>

<style>
  /* Discreto, mas legível: o CDC (art. 36) pede publicidade identificável "fácil e
     imediatamente", não com destaque. */
  .disclosure {
    margin: 20px 0 0;
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: center;
    text-wrap: pretty;
    /* SEM opacidade: o cinza do tema já está no limite de 4.5:1. */
    color: var(--site-color-text-muted);
  }
</style>
