---
import type { IconName } from '@/types/blocks';

/**
 * Ícones inline.
 *
 * SVG direto no HTML em vez de uma biblioteca de ícones: só o traço usado
 * chega ao navegador, sem requisição extra e sem JavaScript. Herdam a cor
 * via `currentColor`, então funcionam em qualquer tema sem configuração.
 *
 * Para adicionar um ícone: inclua o nome em `IconName` (types/blocks.ts)
 * e o traço aqui. O TypeScript cobra os dois lados.
 */

interface Props {
  name: IconName;
  /** Tamanho em px. Padrão 24. */
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

type IconDef = {
  paths: string[];
  /** Logos de marca são desenhos preenchidos; ícones funcionais são traçados. */
  filled?: boolean;
};

