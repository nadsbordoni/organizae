---
import Icon from './Icon.astro';
import type { IconName } from '@/types/blocks';

/**
 * Botão de AÇÃO (confirma, avança, volta), separado do `LinkButton` de propósito: precisa de
 * `disabled`, `type="submit"` e largura total. Com `href` vira `<a>`, para navegação que fica
 * ao lado de ações e precisa da mesma silhueta ("Falar no WhatsApp", "Adicionar ao calendário").
 */

interface Props {
  label: string;
  /** `primary`: só UMA por tela; `secondary`: alternativa de mesmo peso; `ghost`: saída discreta. */
  variant?: 'primary' | 'secondary' | 'ghost';
  icon?: IconName;
  /** `end` é a seta de "seguir" do protótipo: "Entrar →". */
  iconPosition?: 'start' | 'end';
  href?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  /** Ocupa a largura da coluna. */
  full?: boolean;
  download?: string;
  /** Link para fora do painel (WhatsApp): abre em outra aba para a pessoa não perder a tela. */
  newTab?: boolean;
  ariaLabel?: string;
  /** Ganchos do script do fluxo: `data-next`, `data-submit`, etc. */
  [key: `data-${string}`]: string | undefined;
}

const {
  label,
  variant = 'primary',
  icon,
  iconPosition = 'start',
  href,
  type = 'button',
  disabled = false,
  full = true,
  download,
  newTab = false,
  ariaLabel,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

// `aria-disabled` no `<a>`: âncora não conhece `disabled`, e o link desligado
// precisa continuar sendo anunciado como tal.
const stateProps = href
  ? {
      href,
      download,
      ...(newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
      ...(disabled ? { 'aria-disabled': true, tabindex: -1 } : {}),
    }
  : { type, disabled };
---

<Tag
  class="action"
  data-variant={variant}
  data-full={full ? '' : undefined}
  aria-label={ariaLabel}
  {...stateProps}
  {...rest}
>
  {icon && iconPosition === 'start' && <Icon name={icon} size={18} />}
  <span class="action__label">{label}</span>
  {icon && iconPosition === 'end' && <Icon name={icon} size={18} />}
</Tag>

<style>
  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    /* 48px é o mínimo de área de toque. NÃO reduza. */
    min-height: 48px;
    padding: 12px 22px;
    border-radius: var(--site-radius-button);
    border: 1px solid transparent;

    /* O fio da moldura mora numa variável para os estados trocarem só o relevo (como no `LinkButton`). */
    --action-ring: 0 0 0 0 transparent;

    font-family: inherit;
    font-size: 1rem;
    /* A 600 o rótulo parecia fraco no botão. */
    font-weight: 650;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;

    cursor: pointer;
    -webkit-tap-highlight-color: transparent;

    transition:
      transform 0.16s ease,
      box-shadow 0.16s ease,
      background-color 0.16s ease,
      opacity 0.16s ease;
  }

  .action[data-full] {
    display: flex;
    width: 100%;
  }

  .action[data-variant='primary'] {
    background: var(--site-color-brand);
    color: var(--site-color-on-brand);

    /* Moldura da marca SÓ na ação principal: diferencia "confirmar" de "voltar" sem depender de cor. */
    border-width: var(--site-button-ring-gap);
    border-color: var(--site-button-ring-gap-color);
    --action-ring: 0 0 0 var(--site-button-ring-width) var(--site-button-ring-color);
    box-shadow: var(--action-ring), var(--site-shadow-resting);
  }

  .action[data-variant='secondary'] {
    background: var(--site-color-surface);
    color: var(--site-color-text);
    border-color: var(--site-color-border-strong);
    box-shadow: var(--site-shadow-resting);
  }

  .action[data-variant='ghost'] {
    background: none;
    color: var(--site-color-brand);
    min-height: 48px;
    box-shadow: none;
  }

  .action:hover:not(:disabled, [aria-disabled='true']) {
    transform: translateY(-2px);
    box-shadow: var(--action-ring), var(--site-shadow-raised);
  }

  /* NÃO tire o `[aria-disabled='true']` dos `:not()`: link desligado não conhece `disabled`,
     e este hover (0,5,0) venceria o estado desligado, deixando o rótulo a 1,07:1. */
  .action[data-variant='primary']:hover:not(:disabled, [aria-disabled='true']) {
    background: var(--site-color-brand-deep);
  }

  .action[data-variant='ghost']:hover:not(:disabled, [aria-disabled='true']) {
    transform: none;
    box-shadow: none;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .action:active:not(:disabled, [aria-disabled='true']) {
    transform: translateY(0) scale(0.99);
    box-shadow: var(--action-ring), var(--site-shadow-resting);
  }

  .action:focus-visible {
    outline: 3px solid var(--site-color-brand-deep);
    outline-offset: 3px;
  }

  /* Desabilitado continua LEGÍVEL: apagado demais, a pessoa não entende que falta escolher algo. */
  .action:disabled,
  .action[aria-disabled='true'] {
    cursor: not-allowed;
    background: var(--site-color-brand-soft);
    color: var(--site-color-text-muted);
    border-color: transparent;
    box-shadow: none;
  }

  .action__label {
    overflow-wrap: anywhere;
  }

  @media (max-width: 359px) {
    .action {
      font-size: 1rem;
      padding-inline: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .action {
      transition: none;
    }

    /* Repete o seletor do hover/active: um `.action:hover` simples PERDE por especificidade
       (0,2,0 contra 0,4,0) e o botão continuaria subindo. */
    .action:hover:not(:disabled, [aria-disabled='true']),
    .action:active:not(:disabled, [aria-disabled='true']) {
      transform: none;
    }
  }
</style>
