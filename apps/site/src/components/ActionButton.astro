---
import Icon from './Icon.astro';
import type { IconName } from '@/types/blocks';

/**
 * Botão de AÇÃO — o que confirma, avança e volta.
 *
 * Irmão do `LinkButton`, e separado dele de propósito: `LinkButton` é sempre um
 * `<a>` que leva a outro lugar, com seta indicando destino. Este aqui é quase
 * sempre um `<button>` que faz algo NESTA tela, e precisa dos estados que um
 * link não tem — `disabled`, `type="submit"`, largura total.
 *
 * `href` transforma em `<a>` para os casos de fronteira: "Falar no WhatsApp" e
 * "Adicionar ao calendário" são navegação, mas ficam lado a lado com botões de
 * ação e precisam da mesma silhueta.
 */

interface Props {
  label: string;
  /**
   * `primary` é a ação principal da tela — só uma por tela.
   * `secondary` é a alternativa com o mesmo peso estrutural (cartão + fio).
   * `ghost` é a saída discreta: "voltar para o início", "agora não".
   */
  variant?: 'primary' | 'secondary' | 'ghost';
  icon?: IconName;
  /** Presente, vira `<a>`. Ausente, vira `<button>`. */
  href?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  /** Ocupa a largura da coluna. Padrão `true` — é o formato de fluxo no celular. */
  full?: boolean;
  /** Nome do arquivo ao baixar. Usado por "Adicionar ao calendário". */
  download?: string;
  /** Rótulo para leitor de tela quando o texto visível não basta. */
  ariaLabel?: string;
  /** Ganchos do script do fluxo: `data-next`, `data-submit`, etc. */
  [key: `data-${string}`]: string | undefined;
}

const {
  label,
  variant = 'primary',
  icon,
  href,
  type = 'button',
  disabled = false,
  full = true,
  download,
  ariaLabel,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

// `aria-disabled` em vez de `disabled` no `<a>`: âncora não conhece o atributo,
// e um link "desligado" precisa continuar sendo anunciado como tal.
const stateProps = href
  ? { href, download, ...(disabled ? { 'aria-disabled': true, tabindex: -1 } : {}) }
  : { type, disabled };
---

<Tag
  class="action"
  data-variant={variant}
  data-full={full ? '' : undefined}
  aria-label={ariaLabel}
  {...stateProps}
  {...rest}
>
  {icon && <Icon name={icon} size={20} />}
  <span class="action__label">{label}</span>
</Tag>

<style>
  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    min-height: var(--site-button-min-height);
    padding: 12px 22px;
    border-radius: var(--site-radius-button);
    border: 1.5px solid transparent;

    /* Mesmo arranjo do `LinkButton`: o fio da moldura é a primeira sombra e mora
       numa variável, para os estados trocarem só o relevo. */
    --action-ring: 0 0 0 0 transparent;

    font-family: inherit;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;

    cursor: pointer;
    -webkit-tap-highlight-color: transparent;

    transition:
      transform 0.16s ease,
      box-shadow 0.16s ease,
      background-color 0.16s ease,
      opacity 0.16s ease;
  }

  .action[data-full] {
    display: flex;
    width: 100%;
  }

  .action[data-variant='primary'] {
    background: var(--site-color-brand);
    color: var(--site-color-on-brand);

    /* A moldura da marca fica na ação PRINCIPAL, e só nela: é o que diferencia
       "confirmar" de "voltar" sem depender de tamanho nem de cor. */
    border-width: var(--site-button-ring-gap);
    border-color: var(--site-button-ring-gap-color);
    --action-ring: 0 0 0 var(--site-button-ring-width) var(--site-button-ring-color);
    box-shadow: var(--action-ring), var(--site-shadow-resting);
  }

  .action[data-variant='secondary'] {
    background: var(--site-color-surface);
    color: var(--site-color-brand);
    border-color: var(--site-color-border);
    box-shadow: var(--site-shadow-resting);
  }

  .action[data-variant='ghost'] {
    background: none;
    color: var(--site-color-brand);
    min-height: 48px;
    box-shadow: none;
  }

  .action:hover:not(:disabled, [aria-disabled='true']) {
    transform: translateY(-2px);
    box-shadow: var(--action-ring), var(--site-shadow-raised);
  }

  /* O `[aria-disabled='true']` nos dois `:not()` abaixo é o que impede o bug que
     a tela do passo 1 tinha: com nada escolhido, o botão é um LINK desligado, e
     link não conhece `disabled` — usa `aria-disabled`. Sem essa exclusão, passar
     o mouse pintava o fundo de vinho escuro enquanto a cor do texto continuava a
     do estado desligado: 1,07:1, o rótulo desaparecia. O hover ganhava por
     especificidade (0,5,0 contra 0,3,0), então a ordem das regras não salvava. */
  .action[data-variant='primary']:hover:not(:disabled, [aria-disabled='true']) {
    background: var(--site-color-brand-deep);
  }

  .action[data-variant='ghost']:hover:not(:disabled, [aria-disabled='true']) {
    transform: none;
    box-shadow: none;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .action:active:not(:disabled, [aria-disabled='true']) {
    transform: translateY(0) scale(0.99);
    box-shadow: var(--action-ring), var(--site-shadow-resting);
  }

  .action:focus-visible {
    outline: 3px solid var(--site-color-brand-deep);
    outline-offset: 3px;
  }

  /* Desabilitado continua LEGÍVEL: some o relevo e a cor de convite, mas o
     texto segue com contraste. Um botão apagado demais some da tela e a pessoa
     não entende que falta escolher algo. */
  .action:disabled,
  .action[aria-disabled='true'] {
    cursor: not-allowed;
    background: var(--site-color-brand-soft);
    color: var(--site-color-text-muted);
    border-color: transparent;
    box-shadow: none;
  }

  .action__label {
    overflow-wrap: anywhere;
  }

  @media (max-width: 359px) {
    .action {
      font-size: 1rem;
      padding-inline: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .action {
      transition: none;
    }

    /* Seletor repetido igual ao das regras de hover e active acima. Escrito como
       `.action:hover` simples, este `transform: none` PERDIA por especificidade
       (0,2,0 contra 0,4,0) e o botão continuava subindo para quem pediu menos
       movimento. Regra que sobrescreve estado precisa repetir o seletor do estado. */
    .action:hover:not(:disabled, [aria-disabled='true']),
    .action:active:not(:disabled, [aria-disabled='true']) {
      transform: none;
    }
  }
</style>
