---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageContainer from '@/components/PageContainer.astro';
import PageHeading from '@/components/PageHeading.astro';
import Footer from '@/components/Footer.astro';
import { BOOKING_PATH } from '@/lib/blocks';
import type { BookingContext } from '@/lib/booking-ui';
import type { SiteConfig } from '@/types/site';

/**
 * Casca dos passos do agendamento.
 *
 * Cada passo é uma PÁGINA de verdade, com endereço próprio — o botão navega em
 * vez de trocar o que está visível. Isso dá o botão voltar do navegador de
 * graça, deixa recarregar sem perder o que foi escolhido, e faz cada página
 * carregar só o seu próprio HTML.
 *
 * O que já foi escolhido viaja na query (`?servicos=...&data=...&hora=...`).
 * Ver `lib/booking-state.ts`.
 */

interface Props {
  site: SiteConfig;
  /** Passo atual, 1 a 3. A conclusão não numera: já saiu do caminho. */
  step?: 1 | 2 | 3;
  title: string;
  intro?: string;
  /** Destino do botão voltar, sem query: o script dos passos 2 e 3 acrescenta a escolha. */
  backHref: string;
  backLabel: string;
}

const { site, step, title, intro, backHref, backLabel }: Props = Astro.props;

const STEP_NAMES = ['Serviços', 'Data e horário', 'Revisão'];

const seo = {
  ...site.seo,
  title: `${title} • ${site.profile.name}`,
  description: `Escolha o serviço, o dia e o horário no ${site.profile.name}.`,
  // Fora dos buscadores: quem chega aqui vem da página de links, e um resultado
  // de busca caindo no meio do fluxo perderia o contexto do negócio.
  noindex: true,
};

const agenda = site.agenda!;

/**
 * Só o que o navegador precisa. Serviço escondido não sai daqui, então não há
 * como a URL pedir um: `readSelection()` valida contra ESTE catálogo.
 */
const context: BookingContext = {
  agenda: {
    ...agenda,
    categories: agenda.categories
      .filter((category) => !category.hidden)
      .map((category) => ({
        ...category,
        services: category.services.filter((service) => !service.hidden),
      })),
  },
  business: {
    name: site.profile.name,
    base: `/${site.slug}/${BOOKING_PATH}`,
    homeHref: `/${site.slug}`,
    // Endereço para o arquivo de calendário, tirado do bloco de localização — a
    // mesma informação que já está na página de links, sem redigitar.
    address: site.blocks.find((block) => block.type === 'location')?.address.join(', '),
  },
};
---

<SiteLayout theme={site.theme} seo={seo} noindex>
  <PageContainer as="main" id="conteudo">
    <PageHeading title="Agendamento" backHref={backHref} backLabel={backLabel} data-back="" />

    {
      step && (
        <ol class="steps" aria-label={`Passo ${step} de ${STEP_NAMES.length}`}>
          {STEP_NAMES.map((name, index) => (
            <li
              class="steps__item"
              data-state={index + 1 === step ? 'atual' : index + 1 < step ? 'feito' : 'futuro'}
              aria-current={index + 1 === step ? 'step' : undefined}
            >
              <span class="steps__dot" aria-hidden="true" />
              <span class="steps__name">{name}</span>
            </li>
          ))}
        </ol>
      )
    }

    <section class="panel">
      <h2 class="panel__title">{title}</h2>
      {intro && <p class="panel__intro">{intro}</p>}

      <slot />
    </section>

    <Footer note={site.footerNote} siteName={site.profile.name} />
  </PageContainer>
</SiteLayout>

{/* Catálogo e expediente que os passos leem. Como `application/json`, o
    navegador não executa. O `<` escapado impede que um texto com `</script>`
    feche a tag — NÃO tire quando o catálogo vier do banco. */}
<script
  type="application/json"
  id="dados-agendamento"
  set:html={JSON.stringify(context).replace(/</g, '\\u003c')}
  is:inline
></script>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin: 0 0 22px;
    padding: 0;
    list-style: none;
  }

  .steps__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;

    font-size: 0.75rem;
    line-height: 1.3;
    text-align: center;
    color: var(--site-color-text-muted);
  }

  /* A barra é o próprio indicador: cheia no que passou e no atual, apagada no
     que falta. Mais legível que bolinha numerada numa tela de 320px. */
  .steps__dot {
    width: 100%;
    height: 4px;
    border-radius: 999px;
    background: var(--site-color-border);
  }

  .steps__item[data-state='feito'] .steps__dot,
  .steps__item[data-state='atual'] .steps__dot {
    background: var(--site-color-brand);
  }

  .steps__item[data-state='atual'] .steps__name {
    font-weight: 600;
    color: var(--site-color-brand-deep);
  }

  /* O que ainda não chegou fica mais leve, mas legível: 0.7 sobre o fundo da
     página ainda passa de 4.5:1. */
  .steps__item[data-state='futuro'] .steps__name {
    opacity: 0.7;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .panel__title {
    font-family: var(--site-font-body);
    font-size: clamp(1.25rem, 5vw, 1.5rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--site-color-text);
  }

  /* O título e a introdução são um bloco só; o `gap` de 18px do painel
     separaria demais. */
  .panel__intro {
    margin-top: -12px;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--site-color-text-muted);
  }

  @media (max-width: 359px) {
    .steps__name {
      font-size: 0.6875rem;
    }
  }
</style>
