---
import ActionButton from '@/components/ActionButton.astro';
import EmptyState from '@/components/EmptyState.astro';

/**
 * Grade de horários de um dia, preenchida no navegador. CONTRATO com `lib/booking-ui.ts`: a classe
 * `slots__chip`. Só aparece horário em que o serviço INTEIRO cabe antes do fechamento e fora
 * das pausas, então a lista encolher com um serviço mais longo não é bug.
 */

interface Props {
  /** Conversa alternativa quando o dia não tem nada livre. */
  whatsappHref: string;
}

const { whatsappHref }: Props = Astro.props;
---

<section class="slots" data-slots-region hidden>
  <h3 class="slots__title">Horários disponíveis</h3>
  <p class="slots__day" data-slots-day></p>

  {/* `aria-live`: a grade troca sozinha ao escolher outro dia. */}
  <div
    class="slots__grid"
    data-slots-grid
    role="group"
    aria-label="Horários disponíveis"
    aria-live="polite"
  >
  </div>

  <div data-slots-empty hidden>
    <EmptyState
      icon="calendar"
      title="Nenhum horário disponível"
      text="Não sobrou horário para este serviço nesta data. Tente outro dia ou fale comigo no WhatsApp."
    >
      <ActionButton label="Falar no WhatsApp" icon="whatsapp" variant="secondary" href={whatsappHref} />
    </EmptyState>
  </div>

  <div data-slots-nofit hidden>
    <EmptyState
      icon="calendar"
      title="Não coube em nenhum dia"
      text="Nenhum dia tem tempo livre para todos esses serviços juntos. Tire algum ou fale comigo no WhatsApp."
    >
      <ActionButton label="Falar no WhatsApp" icon="whatsapp" variant="secondary" href={whatsappHref} />
    </EmptyState>
  </div>
</section>

<style>
  .slots {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .slots__title {
    font-family: var(--site-font-body);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--site-color-text);
  }

  .slots__day {
    font-size: 0.875rem;
    color: var(--site-color-text-muted);
  }

  .slots__grid {
    /* O `minmax` evita coluna tão fina que "08:00" quebre no meio. */
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    gap: 8px;
    margin-top: 10px;
  }

  .slots__grid:empty {
    display: none;
  }

  .slots__grid :global(.slots__chip) {
    min-height: 48px;
    padding: 10px 8px;
    border-radius: var(--site-radius-button);
    border: 1.5px solid var(--site-color-border);
    background: var(--site-color-surface);

    font-family: inherit;
    font-size: 1rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--site-color-text);

    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 0.16s ease,
      border-color 0.16s ease,
      color 0.16s ease,
      transform 0.16s ease;
  }

  /* Guardado contra o escolhido como no calendário: aqui só a ORDEM das regras faz o
     escolhido ganhar, e ordem é frágil. */
  .slots__grid :global(.slots__chip:hover:not([aria-pressed='true'])) {
    border-color: var(--site-color-brand);
    transform: translateY(-1px);
  }

  .slots__grid :global(.slots__chip:focus-visible) {
    outline: 3px solid var(--site-color-brand-deep);
    outline-offset: 2px;
  }

  .slots__grid :global(.slots__chip[aria-pressed='true']) {
    background: var(--site-color-brand);
    border-color: var(--site-color-brand);
    color: var(--site-color-on-brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .slots__grid :global(.slots__chip) {
      transition: none;
    }

    /* Seletor IDÊNTICO ao do hover, de propósito: com menos especificidade, este
       `transform: none` perderia. */
    .slots__grid :global(.slots__chip:hover:not([aria-pressed='true'])) {
      transform: none;
    }
  }
</style>
