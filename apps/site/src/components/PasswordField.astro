---
import Icon from './Icon.astro';
import TextField from './TextField.astro';

/**
 * Campo de senha com mostrar/ocultar. Com `rules`, lista as regras e marca as cumpridas enquanto a
 * pessoa digita; com `confirms`, avisa quando não coincide com o campo de id indicado. Nos dois
 * casos o navegador não deixa enviar enquanto houver erro (`setCustomValidity`).
 */
interface Props {
  id: string;
  label: string;
  placeholder?: string;
  autocomplete: 'current-password' | 'new-password';
  rules?: boolean;
  /** Id do campo que este confirma. */
  confirms?: string;
  autofocus?: boolean;
}

const { id, label, placeholder, autocomplete, rules = false, confirms, autofocus } = Astro.props;

// As mesmas três do protótipo. O back exige só o mínimo de 8; aqui pedimos mais.
const RULES = [
  { key: 'length', text: 'Pelo menos 8 caracteres' },
  { key: 'case', text: 'Uma letra maiúscula e uma minúscula' },
  { key: 'digit', text: 'Pelo menos um número' },
];
---

<div class="password" data-password data-rules={rules ? '' : undefined} data-confirms={confirms}>
  <TextField
    id={id}
    label={label}
    type="password"
    autocomplete={autocomplete}
    placeholder={placeholder}
    autofocus={autofocus}
    required
    describedBy={rules ? `${id}-regras` : confirms ? `${id}-erro` : undefined}
  >
    <button class="field__end password__toggle" slot="end" type="button" aria-label="Mostrar senha" aria-pressed="false">
      <Icon name="eye" size={20} class="password__show" />
      <Icon name="eye-off" size={20} class="password__hide" />
    </button>
  </TextField>

  {
    rules && (
      <ul class="password__rules" id={`${id}-regras`}>
        {RULES.map((rule) => (
          <li data-rule={rule.key}>{rule.text}</li>
        ))}
      </ul>
    )
  }
  {confirms && <p class="password__error" id={`${id}-erro`} role="alert" hidden>As senhas não coincidem. Digite novamente.</p>}
</div>

<script>
  const RULES: Record<string, (value: string) => boolean> = {
    length: (v) => v.length >= 8,
    case: (v) => /[a-zà-ú]/.test(v) && /[A-ZÀ-Ú]/.test(v),
    digit: (v) => /\d/.test(v),
  };

  for (const box of document.querySelectorAll<HTMLElement>('[data-password]')) {
    const input = box.querySelector<HTMLInputElement>('input')!;
    const toggle = box.querySelector<HTMLButtonElement>('.password__toggle')!;

    toggle.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      toggle.setAttribute('aria-pressed', String(show));
      toggle.setAttribute('aria-label', show ? 'Ocultar senha' : 'Mostrar senha');
    });

    if (box.dataset.rules !== undefined) {
      const items = box.querySelectorAll<HTMLElement>('[data-rule]');
      input.addEventListener('input', () => {
        let ok = true;
        for (const item of items) {
          const met = RULES[item.dataset.rule!]!(input.value);
          item.toggleAttribute('data-met', met);
          ok &&= met;
        }
        input.setCustomValidity(ok ? '' : 'A senha precisa cumprir as três regras.');
      });
    }

    const original = box.dataset.confirms && document.getElementById(box.dataset.confirms);
    if (original instanceof HTMLInputElement) {
      const error = box.querySelector<HTMLElement>('.password__error')!;
      const check = () => {
        const mismatch = input.value !== '' && input.value !== original.value;
        error.hidden = !mismatch;
        input.setAttribute('aria-invalid', String(mismatch));
        input.setCustomValidity(mismatch ? 'As senhas não coincidem.' : '');
      };
      input.addEventListener('input', check);
      original.addEventListener('input', check);
    }
  }
</script>

<style>
  .password {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .password__toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: none;
    color: var(--site-color-text-muted);
    cursor: pointer;
  }

  .password__toggle:hover {
    background: var(--site-color-brand-soft);
    color: var(--site-color-text);
  }

  .password__toggle:focus-visible {
    outline: 3px solid var(--site-color-brand-deep);
    outline-offset: 0;
  }

  .password__toggle :global(.password__hide),
  .password__toggle[aria-pressed='true'] :global(.password__show) {
    display: none;
  }

  .password__toggle[aria-pressed='true'] :global(.password__hide) {
    display: block;
  }

  .password__rules {
    display: flex;
    flex-direction: column;
    gap: 4px;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--site-color-text-muted);
  }

  .password__rules li::before {
    content: '•';
    display: inline-block;
    width: 1em;
  }

  .password__rules li[data-met] {
    color: var(--site-accent-green-deep);
  }

  .password__rules li[data-met]::before {
    content: '✓';
  }

  .password__error {
    font-size: 0.8125rem;
    color: var(--site-color-error);
  }
</style>
