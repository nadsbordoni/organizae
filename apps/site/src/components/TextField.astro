---
/**
 * Campo de texto com rótulo SEMPRE visível num `<label for>`: placeholder como rótulo some ao
 * digitar, some no leitor de tela e não tem contraste. O placeholder só dá um EXEMPLO.
 */

interface Props {
  id: string;
  label: string;
  name?: string;
  placeholder?: string;
  /** Ignorado quando `rows > 1`. */
  type?: 'text' | 'email' | 'password' | 'tel';
  /** NÃO é detalhe: sem `current-password`, o gerenciador de senhas do iPhone não oferece preencher. */
  autocomplete?: string;
  /** Acima de 1, vira `<textarea>`. */
  rows?: number;
  maxlength?: number;
  /** Acrescenta "(opcional)" ao rótulo. Marca-se o opcional porque asterisco em cada linha vira ruído. */
  optional?: boolean;
  /** A validação do navegador é ajuda, nunca garantia: o servidor confere de novo. */
  required?: boolean;
  /** Use em NO MÁXIMO um campo por tela. */
  autofocus?: boolean;
  hint?: string;
  /** Ganchos de script, aplicados no campo em si, não no invólucro. */
  [key: `data-${string}`]: string | undefined;
}

const {
  id,
  label,
  name,
  placeholder,
  type = 'text',
  autocomplete,
  rows = 1,
  maxlength,
  optional = false,
  required = false,
  autofocus = false,
  hint,
  ...rest
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
---

<div class="field">
  <label class="field__label" for={id}>
    {label}
    {optional && <span class="field__optional">(opcional)</span>}
  </label>

  {
    rows > 1 ? (
      <textarea
        class="field__control"
        id={id}
        name={name ?? id}
        rows={rows}
        maxlength={maxlength}
        placeholder={placeholder}
        autocomplete={autocomplete}
        required={required}
        aria-describedby={hintId}
        {...rest}
      />
    ) : (
      <input
        class="field__control"
        type={type}
        id={id}
        name={name ?? id}
        maxlength={maxlength}
        placeholder={placeholder}
        autocomplete={autocomplete}
        required={required}
        autofocus={autofocus}
        aria-describedby={hintId}
        {...rest}
      />
    )
  }

  {hint && <p class="field__hint" id={hintId}>{hint}</p>}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field__label {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--site-color-text);
  }

  .field__optional {
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--site-color-text-muted);
  }

  .field__control {
    width: 100%;
    padding: 15px 16px;
    border-radius: var(--site-radius-field);
    border: 1px solid var(--site-color-border-strong);
    background: var(--site-color-surface);

    font-family: inherit;
    /* 16px é o mínimo que impede o iOS de dar zoom ao focar o campo. NÃO reduza. */
    font-size: 1rem;
    line-height: 1.5;
    color: var(--site-color-text);

    resize: vertical;
    transition: border-color 0.16s ease;
  }

  .field__control::placeholder {
    /* Placeholder é texto: NÃO clareie abaixo de 4.5:1 (o cinza do protótipo, #8f8e8c, dá 3,2:1). */
    color: var(--site-color-text-muted);
    opacity: 1;
  }

  .field__control:hover {
    border-color: var(--site-color-brand);
  }

  .field__control:focus-visible {
    outline: 3px solid var(--site-color-brand-deep);
    outline-offset: 2px;
    border-color: var(--site-color-brand);
  }

  .field__hint {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--site-color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .field__control {
      transition: none;
    }
  }
</style>
