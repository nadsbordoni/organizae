---
import Icon from './Icon.astro';
import { linkAttrs } from '@/lib/links';
import type { IconName } from '@/types/blocks';

/**
 * Botão de link, o primitivo visual da página: vários tipos de bloco renderizam por aqui.
 * Dois desenhos, como no protótipo: o principal é cheio e centrado; o comum tem o ícone num
 * quadradinho cuja cor vem de `--tone-soft`, que a `BlockList` alterna.
 */

interface Props {
  title: string;
  subtitle?: string;
  href: string;
  icon?: IconName;
  image?: { src: string; alt: string };
  emphasis?: 'primary' | 'default';
  /** Sobrescreve a detecção automática de link externo. */
  external?: boolean;
  /** Link que dá comissão. Acrescenta `sponsored` ao `rel`. */
  affiliate?: boolean;
  ariaLabel?: string;
}

const {
  title,
  subtitle,
  href,
  icon,
  image,
  emphasis = 'default',
  external,
  affiliate,
  ariaLabel,
} = Astro.props;

const primary = emphasis === 'primary';
---

<a
  class="btn"
  href={href}
  data-emphasis={emphasis}
  aria-label={ariaLabel}
  {...linkAttrs({ href, external, affiliate })}
>
  {
    !primary && (
      <span class="btn__lead" aria-hidden="true">
        {image ? (
          <img src={image.src} alt={image.alt} width="40" height="40" loading="lazy" decoding="async" />
        ) : (
          icon && <Icon name={icon} size={18} />
        )}
      </span>
    )
  }

  <span class="btn__text">
    <span class="btn__title">
      {title}
      {primary && icon && <Icon name={icon} size={18} />}
    </span>
    {subtitle && <span class="btn__subtitle">{subtitle}</span>}
  </span>

  {
    !primary && (
      <span class="btn__trail" aria-hidden="true">
        <Icon name="chevron-right" size={18} />
      </span>
    )
  }
</a>

<style>
  .btn {
    display: grid;
    align-items: center;
    gap: 14px;

    min-height: var(--site-button-min-height);
    border-radius: var(--site-radius-button);
    border: 1px solid transparent;

    /* O fio da moldura é a PRIMEIRA sombra e mora numa variável: `:hover` e `:active`
       apagariam o fio se redeclarassem a lista de sombras do zero. */
    --btn-ring: 0 0 0 0 transparent;
    box-shadow: var(--btn-ring), var(--site-shadow-resting);

    text-decoration: none;
    /* Evita o realce cinza de toque no iOS; temos estado :active próprio. */
    -webkit-tap-highlight-color: transparent;

    transition:
      transform 0.16s ease,
      box-shadow 0.16s ease,
      background-color 0.16s ease;
  }

  .btn[data-emphasis='default'] {
    grid-template-columns: 40px 1fr 18px;
    padding: 13px 16px 13px 13px;
    background: var(--site-button-background);
    color: var(--site-button-color);
    border-color: var(--site-button-border-color);
    text-align: left;
  }

  .btn__lead {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--tone-soft, var(--site-accent-yellow-soft));
    color: var(--site-color-text);
    overflow: hidden;
  }

  .btn__lead:empty {
    /* Esconde mas mantém a coluna: o texto não muda de lugar entre uma linha e outra. */
    visibility: hidden;
  }

  .btn__lead img {
    width: 40px;
    height: 40px;
    object-fit: cover;
  }

  .btn__trail {
    display: flex;
    opacity: 0.7;
  }

  .btn[data-emphasis='primary'] {
    grid-template-columns: 1fr;
    padding: 12px 20px;
    text-align: center;
    background: var(--site-color-brand);
    color: var(--site-color-on-brand);

    /* Sem tema que declare, o respiro é a borda invisível e o fio tem espessura zero
       (ver `button.ringGap` em `types/theme.ts`). */
    border-width: var(--site-button-ring-gap);
    border-color: var(--site-button-ring-gap-color);
    --btn-ring: 0 0 0 var(--site-button-ring-width) var(--site-button-ring-color);
  }

  /* Mesmo rótulo do botão de ação (`ActionButton`). */
  .btn[data-emphasis='primary'] .btn__title {
    justify-content: center;
    font-weight: 650;
  }

  .btn__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .btn__title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .btn__subtitle {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--site-color-text-muted);
    overflow-wrap: anywhere;
  }

  /* Sobre a cor da marca o cinza não passa de 4.5:1; a cor do texto a 0.8 de opacidade passa. */
  .btn[data-emphasis='primary'] .btn__subtitle {
    color: inherit;
    opacity: 0.8;
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--btn-ring), var(--site-shadow-raised);
  }

  .btn[data-emphasis='primary']:hover {
    background: var(--site-color-brand-deep);
  }

  .btn:active {
    transform: translateY(0) scale(0.99);
    box-shadow: var(--btn-ring), var(--site-shadow-resting);
  }

  .btn:focus-visible {
    outline: 3px solid var(--site-color-brand-deep);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }

    .btn:hover,
    .btn:active {
      transform: none;
    }
  }
</style>
