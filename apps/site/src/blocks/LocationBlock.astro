---
import Icon from '@/components/Icon.astro';
import { mapEmbedUrl } from '@/lib/links';
import type { LocationBlock } from '@/types/blocks';

/**
 * Card de localização.
 *
 * Tem estrutura própria (endereço visível em linhas, mapa opcional) em vez de
 * ser só um botão: quem procura "como chegar" muitas vezes quer LER o
 * endereço, não abrir o mapa.
 *
 * O card NÃO é um `<a>` inteiro porque um iframe não pode viver dentro de um
 * link. O alvo clicável é a faixa do endereço, que continua com área de toque
 * de sobra.
 */

interface Props {
  block: LocationBlock;
}

const { block }: Props = Astro.props;
const { title, subtitle, address, mapsUrl, map = false, mapQuery } = block;

/**
 * `map` aceita `true` (derivamos a busca do endereço) ou já a URL pronta do
 * "Incorporar um mapa" do Google — que é mais precisa, porque carrega o
 * ponto e o zoom exatos que a pessoa marcou.
 */
const embedUrl =
  typeof map === 'string' ? map : map ? mapEmbedUrl(mapQuery ?? address.join(', ')) : null;
---

<div class="loc">
  {
    embedUrl && (
      <div class="loc__map">
        <iframe
          src={embedUrl}
          title={`Mapa da localização: ${address.join(', ')}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      </div>
    )
  }

  <a class="loc__link" href={mapsUrl} target="_blank" rel="noopener noreferrer">
    <span class="loc__icon" aria-hidden="true">
      <Icon name="pin" size={22} />
    </span>

    <span class="loc__body">
      <span class="loc__title">{title}</span>
      {subtitle && <span class="loc__subtitle">{subtitle}</span>}
      <address class="loc__address">
        {address.map((line) => <span>{line}</span>)}
      </address>
    </span>

    <span class="loc__trail" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="m6 3.5 5 4.5-5 4.5" />
      </svg>
    </span>
  </a>
</div>

<style>
  .loc {
    border-radius: var(--site-radius-card);
    border: 1.5px solid var(--site-color-border);
    background: var(--site-color-surface);
    box-shadow: var(--site-shadow-resting);
    /* Recorta o mapa nos cantos arredondados do card. */
    overflow: hidden;
  }

  .loc__map {
    /* Proporção fixa reserva o espaço antes do iframe chegar, evitando que a
       página pule quando o mapa carrega. */
    aspect-ratio: 16 / 10;
    background: var(--site-color-brand-soft);
  }

  .loc__map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .loc__link {
    display: grid;
    grid-template-columns: 26px 1fr 16px;
    align-items: start;
    gap: 12px;

    padding: 16px 18px;
    color: var(--site-color-text);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;

    transition: background-color 0.16s ease;
  }

  .loc__link:hover {
    background: var(--site-color-brand-soft);
  }

  .loc__link:focus-visible {
    outline: 3px solid var(--site-color-brand-deep);
    /* Para dentro: o card tem `overflow: hidden` e cortaria um contorno externo. */
    outline-offset: -3px;
  }

  .loc__icon {
    display: flex;
    justify-content: center;
    /* Alinha o ícone com a primeira linha de texto. */
    padding-top: 2px;
    color: var(--site-color-brand);
  }

  .loc__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .loc__title {
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  .loc__subtitle {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--site-color-text-muted);
  }

  .loc__address {
    display: flex;
    flex-direction: column;
    font-style: normal;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--site-color-text-muted);
    overflow-wrap: anywhere;
  }

  .loc__trail {
    display: flex;
    justify-content: center;
    padding-top: 4px;
    opacity: 0.45;
  }

  @media (prefers-reduced-motion: reduce) {
    .loc__link {
      transition: none;
    }
  }
</style>
