---
import Icon from '@/components/Icon.astro';
import { mapEmbedUrl } from '@/lib/links';
import type { LocationBlock } from '@/types/blocks';

/**
 * Card de localização com o endereço visível: quem procura "como chegar" muitas vezes
 * quer LER o endereço. NÃO é um `<a>` inteiro porque iframe não pode ficar dentro de link.
 */

interface Props {
  block: LocationBlock;
}

const { block }: Props = Astro.props;
const { title, subtitle, address, mapsUrl, map = false, mapQuery } = block;

// `map`: `true` deriva a busca do endereço; a URL do "Incorporar um mapa" do Google
// é mais precisa, porque traz o ponto e o zoom exatos.
const embedUrl =
  typeof map === 'string' ? map : map ? mapEmbedUrl(mapQuery ?? address.join(', ')) : null;
---

<div class="loc">
  {
    embedUrl && (
      <div class="loc__map">
        <iframe
          src={embedUrl}
          title={`Mapa da localização: ${address.join(', ')}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      </div>
    )
  }

  <a class="loc__link" href={mapsUrl} target="_blank" rel="noopener noreferrer">
    <span class="loc__icon" aria-hidden="true">
      <Icon name="pin" size={18} />
    </span>

    <span class="loc__body">
      <span class="loc__title">{title}</span>
      {subtitle && <span class="loc__subtitle">{subtitle}</span>}
      <address class="loc__address">
        {address.map((line) => <span>{line}</span>)}
      </address>
    </span>

    <span class="loc__trail" aria-hidden="true">
      <Icon name="chevron-right" size={18} />
    </span>
  </a>
</div>

<style>
  .loc {
    border-radius: var(--site-radius-button);
    border: 1px solid var(--site-color-border-strong);
    background: var(--site-color-surface);
    box-shadow: var(--site-shadow-resting);
    overflow: hidden;
  }

  .loc__map {
    /* Reserva o espaço antes do iframe chegar, para a página não pular. */
    aspect-ratio: 16 / 10;
    background: var(--site-color-brand-soft);
  }

  .loc__map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .loc__link {
    display: grid;
    grid-template-columns: 40px 1fr 18px;
    align-items: center;
    gap: 14px;

    padding: 13px 16px 13px 13px;
    color: var(--site-color-text);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;

    transition: background-color 0.16s ease;
  }

  .loc__link:hover {
    background: var(--site-color-brand-soft);
  }

  .loc__link:focus-visible {
    outline: 3px solid var(--site-color-brand-deep);
    /* Para dentro: o card tem `overflow: hidden` e cortaria um contorno externo. */
    outline-offset: -3px;
  }

  .loc__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--tone-soft, var(--site-accent-blue-soft));
    color: var(--site-color-text);
  }

  .loc__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .loc__title {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
  }

  .loc__subtitle {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--site-color-text-muted);
  }

  .loc__address {
    display: flex;
    flex-direction: column;
    font-style: normal;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--site-color-text-muted);
    overflow-wrap: anywhere;
  }

  .loc__trail {
    display: flex;
    justify-content: center;
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .loc__link {
      transition: none;
    }
  }
</style>
